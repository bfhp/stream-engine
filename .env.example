# Core application settings. The installer writes these values automatically.
# Replace every "replace-with-..." value before using this file directly.
APP_ENV=prod
APP_SECRET=replace-with-64-character-random-hex
SITE_URL=https://example.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stream_engine
DB_USERNAME=stream_engine
DB_PASSWORD=replace-with-database-password

# Cache
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
CACHE_PREFIX=default

# Scheduler. Production deployments should run bin/cron.php once per minute.
CRON_KEY=replace-with-a-different-64-character-random-hex
CRON_MODE=os

# Optional filesystem overrides
# UPLOADS_DIR=storage/uploads
# TMP_DIR=/tmp
# TWIG_CACHE_DIR=/tmp/stream-engine-twig
# THEME_DIR=/absolute/path/to/theme

# Optional SMTP delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=stream-engine
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_ENCRYPTION=tls
# SMTP_FROM=noreply@example.com

# Optional S3-compatible object storage; configure the whole group together.
# OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_BUCKET=stream-engine
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
# OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/stream-engine
