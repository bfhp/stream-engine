<!-- Toast container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080">
    {# No live role: screen readers hear the message through the announcer
       in shared/ui.ts (a hidden toast that is then shown is not read). #}
    <div id="globalToast" class="toast align-items-center text-bg-success border-0">
        <div class="d-flex">
            <div class="toast-body" id="globalToastBody">
                {{ trans('view.ui.message') }}
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                data-bs-dismiss="toast" aria-label="{{ trans('view.ui.close') }}"></button>
        </div>
    </div>
</div>
