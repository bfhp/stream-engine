{# Bootstrap markup of the Users module's components/users/register-form.twig; keeps its hooks. #}
<form id="registerForm" method="post" action="/api/v1/users" data-success-url="{{ successUrl }}" data-honeypot-field="{{ honeypotField }}" data-registration-mode="{{ registrationMode }}" data-captcha-provider="{{ captchaProvider }}">
    {% block register_hidden %}
    <div class="mb-3 visually-hidden" aria-hidden="true">
        <input
                name="{{ honeypotField }}"
                type="text"
                class="form-control"
                id="registerInputHoneypot"
                autocomplete="off"
                tabindex="-1">
    </div>
    {% endblock %}

    {% block register_email %}
    <div class="mb-3">
        <label for="registerInputEmail" class="form-label">{{ trans('view.users.register.form.02') }}</label>
        <input
                type="email"
                class="form-control"
                id="registerInputEmail"
                name="email"
                required
                autocomplete="email"
                placeholder="name@example.com"
                aria-describedby="emailHelp">
        <div id="emailHelp" class="form-text">{{ trans('view.users.register.form.03') }}</div>
    </div>
    {% endblock %}

    {% block register_password %}
    <div class="mb-3">
        <label for="registerInputPassword" class="form-label">{{ trans('view.auth.password') }}</label>
        <input
                type="password"
                class="form-control"
                id="registerInputPassword"
                name="password"
                required
                minlength="10"
                autocomplete="new-password"
                aria-describedby="passwordHelp">
        <div id="passwordHelp" class="form-text">{{ trans('view.users.register.form.04') }}</div>
    </div>
    {% endblock %}

    {% block register_captcha %}
    {% if captchaProvider != 'none' %}
    <div class="mb-3">
        <label class="form-label">{{ trans('view.users.register.form.05') }}</label>
        <div class="col-sm-10">
            {% if captchaProvider == 'turnstile' %}
                <div class="cf-turnstile" data-sitekey="{{ captchaSiteKey }}" data-action="registration"></div>
            {% elseif captchaProvider == 'hcaptcha' %}
                <div class="h-captcha" data-sitekey="{{ captchaSiteKey }}"></div>
            {% endif %}
        </div>
    </div>
    {% endif %}
    {% endblock %}

    {% block register_submit %}
    <button type="submit" class="btn btn-primary">{{ trans('view.auth.register') }}</button>
    {% endblock %}
</form>
