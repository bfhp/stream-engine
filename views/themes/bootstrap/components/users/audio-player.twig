{# Bootstrap markup of the Users module's components/users/audio-player.twig; keeps its hooks. #}
{% if audioPlaylist is defined and audioPlaylist %}
    {% set firstTrack = audioPlaylist|first %}
    <div class="card mb-3 audio-player-card" role="region" aria-label="{{ trans('js.audio.player') }}" data-audio-player data-playlist="{{ audioPlaylist|json_encode|e('html_attr') }}">
        <div class="card-body p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <button type="button" class="btn btn-sm btn-outline-secondary audio-player-btn" data-audio-prev title="{{ trans('view.users.audio.player.01') }}" aria-label="{{ trans('view.users.audio.player.01') }}">
                    <i class="bi bi-skip-backward-fill" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-primary audio-player-btn" data-audio-toggle title="{{ trans('view.users.audio.player.02') }}" aria-label="{{ trans('view.users.audio.player.02') }}">
                    <i class="bi bi-play-fill" data-audio-toggle-icon aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary audio-player-btn" data-audio-next title="{{ trans('view.users.audio.player.03') }}" aria-label="{{ trans('view.users.audio.player.03') }}">
                    <i class="bi bi-skip-forward-fill" aria-hidden="true"></i>
                </button>

                <div class="min-w-0 flex-grow-1">
                    <div class="small fw-semibold audio-player-wrap"><span class="visually-hidden">{{ trans('js.audio.current_track') }} </span><bdi data-audio-title>{{ firstTrack.title }}</bdi></div>
                    {% if firstTrack.postUrl %}
                        <a href="{{ firstTrack.postUrl }}" class="small text-body-secondary audio-player-wrap d-block text-decoration-none" data-audio-post>{{ firstTrack.postTitle ?: trans('view.users.audio.player.04') }}</a>
                    {% else %}
                        <span class="small text-body-secondary audio-player-wrap d-block" data-audio-post>{{ firstTrack.postTitle ?: trans('view.users.audio.player.04') }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 small text-body-secondary">
                <span class="audio-player-time" data-audio-current aria-hidden="true">0:00</span>
                <input type="range" class="form-range audio-player-range" min="0" max="1000" value="0" step="1" data-audio-seek aria-label="{{ trans('view.users.audio.player.05') }}">
                <span class="audio-player-time text-end" data-audio-duration aria-hidden="true">0:00</span>
            </div>

            <ul class="audio-player-list mt-2" role="list" aria-label="{{ trans('js.audio.playlist') }}" data-audio-list>
                {% for track in audioPlaylist %}
                    <li>
                        <button
                            type="button"
                            class="audio-player-track{% if loop.first %} is-active{% endif %}"
                            {% if loop.first %}aria-current="true"{% endif %}
                            data-audio-track-index="{{ loop.index0 }}"
                            title="{{ track.title }}"
                        >
                            <span class="audio-player-wrap"><bdi>{{ track.title }}</bdi></span>
                        </button>
                    </li>
                {% endfor %}
            </ul>

            <audio preload="metadata" data-audio-element></audio>
        </div>
    </div>
{% endif %}
