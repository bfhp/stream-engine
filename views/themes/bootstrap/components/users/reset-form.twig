{# Bootstrap markup of the Users module's components/users/reset-form.twig; keeps its hooks. #}
<form id="resetPasswordForm"
      method="post"
      action="/api/v1/retrieve">

    <input type="hidden" name="token" value="{{ token }}">

    {% set passwordId = 'resetPassword' %}

    {% block reset_password %}
        <div class="mb-4">
            <label for="{{ passwordId }}" class="form-label">
                {{ trans('view.profile.tabs.security.02') }}
            </label>

            <input
                    class="form-control"
                    type="password"
                    id="{{ passwordId }}"
                    name="password"
                    required
                    autocomplete="new-password"
                    minlength="10"
                    maxlength="255"
                    aria-describedby="resetPasswordHelp"
            >
            <div id="resetPasswordHelp" class="form-text">{{ trans('view.users.register.form.04') }}</div>
        </div>
    {% endblock %}

    {# No second field: the "Show password" button catches typos (shared/password-toggle.ts). #}
    {% block reset_password_confirm %}{% endblock %}

    {% block reset_submit %}
        <button type="submit" class="btn btn-primary">
            {{ trans('view.users.reset.form.03') }}
        </button>
    {% endblock %}

</form>
