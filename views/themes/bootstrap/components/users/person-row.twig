{# Bootstrap markup of the Users module's person-row.twig - same fill points. #}
{% set asTemplate = asTemplate|default(false) %}
<a href="{{ row.url ?: '#' }}" class="d-flex align-items-center gap-2 text-body text-decoration-none" data-slot-attr="href:url">
    <img src="{{ row.avatarUrl }}" alt="" class="rounded-circle bg-body-secondary object-fit-cover flex-shrink-0" width="36" height="36" data-slot-attr="src:avatar">
    <span class="small"><bdi data-slot="name">{{ row.displayName }}</bdi></span>
    {% if row.roleLabel|default(null) or asTemplate %}
        <span class="badge text-bg-secondary ms-auto" data-slot="role" data-slot-optional="role">{{ row.roleLabel|default('') }}</span>
    {% endif %}
</a>
