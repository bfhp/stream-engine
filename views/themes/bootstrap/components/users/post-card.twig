{# Bootstrap markup of the Users module's post-card.twig - same fill points.
    Blog-post feed card, shared by the profile feed (modules/users/show.twig)
    and the community feeds (community.twig, community-show.twig).

    Rendered once per post, and once more inside <template data-ui="post-card">
    (asTemplate: true) for the cards assets-src/pages/user-cards.ts appends from
    the API. In template mode every optional piece is rendered so the script
    can fill or drop it; a theme overriding this file keeps the fill points:
      image | noImage, authorAvatar, authorName, authorUrl | authorText,
      date, readTime, dateAndRead, hasMeta, title, url, excerpt,
      hasTags (+ data-post-tags, filled with post-tag.twig copies),
      comments, rating | noRating, audioTrackId.

    Expects: post (card array), showAuthor (bool, default false), asTemplate
    (bool, default false).
#}
{% set showAuthor = showAuthor|default(false) %}
{% set asTemplate = asTemplate|default(false) %}

<article class="card">
    <div class="row g-0">
        <div class="col-sm-4">
            {% if post.imageUrl or asTemplate %}
                <img src="{{ post.imageUrl }}" alt="" class="w-100 h-100 object-fit-cover" style="min-height: 150px;" data-slot-attr="src:image" data-slot-optional="image">
            {% endif %}
            {% if not post.imageUrl or asTemplate %}
                <div class="d-flex align-items-center justify-content-center h-100 bg-body-secondary text-body-tertiary" style="min-height: 150px;" data-slot-optional="noImage">
                    <i class="bi bi-image fs-2"></i>
                </div>
            {% endif %}
        </div>
        <div class="col-sm-8">
            <div class="card-body">
                {% if showAuthor %}
                    <div class="d-flex align-items-center flex-wrap gap-2 text-body-secondary small mb-2">
                        <img src="{{ post.authorAvatarUrl }}" alt="" class="rounded-circle bg-body-secondary object-fit-cover flex-shrink-0" width="24" height="24" data-slot-attr="src:authorAvatar">
                        {% if post.authorUrl or asTemplate %}
                            <a href="{{ post.authorUrl }}" class="fw-semibold text-body text-decoration-none" data-slot-attr="href:authorUrl" data-slot-optional="authorUrl"><bdi data-slot="authorName">{{ post.authorName }}</bdi></a>
                        {% endif %}
                        {% if not post.authorUrl or asTemplate %}
                            <span class="fw-semibold" data-slot-optional="authorText"><bdi data-slot="authorName">{{ post.authorName }}</bdi></span>
                        {% endif %}
                        {% if post.dateLabel or asTemplate %}<span data-slot-optional="date">&middot;</span><span data-slot="date" data-slot-optional="date">{{ post.dateLabel }}</span>{% endif %}
                        {% if post.readTimeLabel or asTemplate %}<span data-slot-optional="readTime">&middot;</span><span data-slot="readTime" data-slot-optional="readTime">{{ post.readTimeLabel }}</span>{% endif %}
                    </div>
                {% elseif post.dateLabel or post.readTimeLabel or asTemplate %}
                    <div class="d-flex align-items-center gap-2 text-body-secondary small mb-2" data-slot-optional="hasMeta">
                        {% if post.dateLabel or asTemplate %}
                            <i class="bi bi-calendar3" data-slot-optional="date"></i><span data-slot="date" data-slot-optional="date">{{ post.dateLabel }}</span>
                        {% endif %}
                        {% if (post.dateLabel and post.readTimeLabel) or asTemplate %}<span data-slot-optional="dateAndRead">&middot;</span>{% endif %}
                        {% if post.readTimeLabel or asTemplate %}<span data-slot="readTime" data-slot-optional="readTime">{{ post.readTimeLabel }}</span>{% endif %}
                    </div>
                {% endif %}

                <h3 class="h5 card-title mb-2">
                    <a href="{{ post.url ?: '#' }}" class="text-body text-decoration-none stretched-link" data-slot="title" data-slot-attr="href:url">{{ post.title }}</a>
                </h3>

                {% if post.excerpt or asTemplate %}
                    <p class="card-text text-body-secondary small mb-3" data-slot="excerpt" data-slot-optional="excerpt">{{ post.excerpt }}</p>
                {% endif %}

                {% if post.tags or asTemplate %}
                    <div class="d-flex flex-wrap gap-1 mb-3" data-post-tags data-slot-optional="hasTags">
                        {% for tag in post.tags|default([]) %}
                            {% include 'components/users/post-tag.twig' with {tag: tag} only %}
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="d-flex flex-wrap align-items-center gap-3 text-body-secondary small">
                    <span><i class="bi bi-chat-left-text me-1"></i><span data-slot="comments">{{ post.commentCount }}</span></span>
                    {% if post.ratingCount > 0 or asTemplate %}
                        <span data-slot-optional="rating"><i class="bi bi-star-fill me-1" style="color:#f5a623;"></i><span data-slot="rating">{{ post.ratingAverage|number_format(1) }}</span></span>
                    {% endif %}
                    {% if not (post.ratingCount > 0) or asTemplate %}
                        <span data-slot-optional="noRating"><i class="bi bi-star me-1"></i>{{ trans('view.users.post.card.01') }}</span>
                    {% endif %}
                    {% if post.audioTrackId or asTemplate %}
                        <button type="button" class="btn btn-sm btn-outline-primary position-relative z-1" data-audio-play-track-id="{{ post.audioTrackId }}"
                                data-slot-optional="audioTrackId" data-slot-attr="data-audio-play-track-id:audioTrackId">
                            <i class="bi bi-play-fill me-1"></i>{{ trans('view.users.post.card.02') }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</article>
