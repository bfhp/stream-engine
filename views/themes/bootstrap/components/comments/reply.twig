<article class="reply border-top pt-3 mt-3" id="comment-{{ reply.id }}" data-id="{{ reply.id }}" data-slot-attr="data-id:id id:anchor">
    {% block reply_header %}
        <div class="comment-meta d-flex align-items-center gap-2 mb-2">
            {% block reply_avatar %}
                <img
                    src="{{ reply.authorAvatarUrl }}"
                    alt="{{ reply.authorDisplayName }}"
                    class="comment-avatar rounded-2"
                    width="32"
                    height="32"
                    data-slot-attr="src:avatar alt:author"
                >
            {% endblock %}
            {% block reply_meta %}
                <div class="comment-meta-text min-w-0">
                    <div class="comment-author fw-semibold lh-sm"><bdi data-slot="author">{{ reply.authorDisplayName }}</bdi></div>
                    {% if reply.createdAtLabel %}
                        <time class="comment-date small text-secondary"
                              datetime="{{ reply.createdAt ? reply.createdAt|date('c') : '' }}"
                              {% if reply.createdAtTitle %}title="{{ reply.createdAtTitle }}"{% endif %}
                              data-slot="date"
                              data-slot-attr="datetime:datetime title:dateTitle"
                              data-slot-optional="date">
                            {{ reply.createdAtLabel }}
                        </time>
                    {% endif %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}

    {% block reply_content %}
        <div class="reply-content" dir="auto" data-slot-html="content">
            {{ reply.content|raw }}
        </div>
    {% endblock %}
</article>
