{# Bootstrap markup of one search result; same data-slot* fill points as the
   module's components/search/result.twig. #}
<div class="search-item search-result py-3 border-bottom">
    <div class="search-result-meta small text-muted mb-1">
        <span class="search-result-kind" data-slot="kind">{{ result.kind }}</span>
        <span data-slot="author" data-slot-optional="author">{{ result.author }}</span>
        <span data-slot="date" data-slot-attr="title:dateTitle" data-slot-optional="date">{{ result.date }}</span>
    </div>
    <a href="{{ result.url }}" class="search-result-title text-decoration-none fw-semibold" data-slot="title" data-slot-attr="href:url">{{ result.title }}</a>
    <div class="search-result-snippet text-body-secondary mt-1" data-slot="snippet" data-slot-optional="snippet">{{ result.snippet }}</div>
</div>
