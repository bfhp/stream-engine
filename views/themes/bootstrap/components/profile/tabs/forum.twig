{% extends 'components/ui/tab-pane.twig' %}

{# Bootstrap markup of the Profile module's forum.twig; same hooks (data-*, names, ids). #}

{% block tab_content %}
    <form method="post" action="/api/v1/my/forum" data-profile-form>
        <div class="mb-3">
            <label class="form-label" for="profileSignature">{{ trans('view.profile.tabs.forum.01') }}</label>
            <textarea id="profileSignature" class="form-control" name="signature" rows="5" aria-describedby="profileSignatureHelp">{{ user.signature }}</textarea>
            <div class="form-text" id="profileSignatureHelp">
                {{ trans('view.profile.tabs.forum.02') }}
                <code>&lt;b&gt;</code>, <code>&lt;i&gt;</code>, <code>&lt;a&gt;</code> {{ trans('view.forums.topic.form.36') }}
                <code>&lt;img&gt;</code> {{ trans('view.profile.tabs.forum.03') }}
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button class="btn btn-primary" type="submit">{{ trans('view.forums.topic.form.41') }}</button>
            <span class="small profile-status" role="status" data-profile-status></span>
        </div>
    </form>
{% endblock %}
