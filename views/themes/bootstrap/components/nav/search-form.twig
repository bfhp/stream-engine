{% set searchUrl = action_url('search.results') %}
{% if searchUrl %}
    <form class="d-flex me-2 mt-3 mt-lg-0" role="search" method="get" action="{{ searchUrl }}">
        <div class="input-group">
            <input class="form-control" required name="q" minlength="3" type="search" placeholder="{{ trans('view.nav.search') }}" aria-label="{{ trans('view.nav.search') }}"/>
            <button class="btn btn-outline-secondary input-group-text" type="submit" aria-label="{{ trans('view.nav.search') }}"><i class="bi bi-search" aria-hidden="true"></i></button>
        </div>
    </form>
{% endif %}
