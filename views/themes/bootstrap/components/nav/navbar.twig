{# Burger is shown only when the top menu has items; otherwise search (if any) is rendered inline. #}
{% set hasTopMenu = topMenu is not empty %}
{% set hasSearch = action_url('search.results') is not empty %}

{% block navbar_burger %}
{% if hasTopMenu %}
    {# BURGER #}
    <button class="navbar-toggler order-3 order-lg-2"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="{{ trans('view.nav.open_menu') }}">
        <span class="navbar-toggler-icon"></span>
    </button>
{% endif %}
{% endblock %}

{# Menu #}
{% if hasTopMenu or hasSearch %}
{% if hasTopMenu %}<div class="collapse navbar-collapse order-4 order-lg-4" id="mainNavbar">{% else %}<div class="navbar-collapse order-4 order-lg-4">{% endif %}
    {% block navbar_menu %}
    {% if hasTopMenu %}
        {% include 'components/nav/menu.twig' with {
            items: topMenu,
            menuClass: 'navbar-nav me-auto',
            itemClass: 'nav-link'
        } %}
    {% endif %}
    {% endblock %}

    {% block navbar_search %}
        {% include 'components/nav/search-form.twig' %}
    {% endblock %}
</div>
{% endif %}
