{# Bootstrap markup of the Article module's components/article/card.twig. #}
<div class="col-md-4 mb-3 mb-md-0">
    <div class="card">
        <div class="card-body">
            <h5 class="mb-1">{{ item.title }}</h5>

            <p class="mb-2 text-muted">
                {{ item.description }}
            </p>

            {# The name starts with the visible words (WCAG 2.5.3); the hidden title tells the links apart. #}
            <a href="{{ item.canonicalUrl }}" class="btn btn-primary">
                {{ trans('view.article.card.01') }}<span class="visually-hidden">: {{ item.title }}</span>
            </a>
        </div>
    </div>
</div>
