{% extends '@default/partials/header.twig' %}

{% block header_class %}sticky-top shadow-sm{% endblock %}

{% block header_inner %}
<div class="layout-wrapper container">
    {% block header_navbar %}
    <nav class="navbar navbar-expand-lg">
        {# Top row #}
        <div class="container-fluid d-flex align-items-center">
            {% block header_logo %}
            <a href="/" class="navbar-brand d-flex align-items-center gap-2 order-1">
                {% if headerLogo %}
                    <img class="header-logo" src="{{ headerLogo }}" alt=""
                        {%- if headerLogoSize|default(null) %} width="{{ headerLogoSize.width }}" height="{{ headerLogoSize.height }}" style="--header-logo-block-size: min({{ headerLogoSize.height }}px, 2.5rem)"{% endif %}>
                {% endif %}
                <span class="fw-semibold">{{ siteName }}</span>
            </a>
            {% endblock %}
            {{ block('header_menu') }}
            {{ block('header_actions') }}
        </div>
    </nav>
    {% endblock %}
    {{ block('header_breadcrumbs') }}
</div>
{% endblock %}
