{% extends '@default/partials/header.twig' %}

{% block header_class %}text-light sticky-top shadow-sm{% endblock %}

{% block header_inner %}
<div class="layout-wrapper container">
    {% block header_navbar %}
    <nav class="navbar navbar-expand-lg">
        {# Top row #}
        <div class="container-fluid d-flex align-items-center">
            {% block header_logo %}
            <a href="/" class="navbar-brand d-flex align-items-center order-1">
                <span class="fw-semibold">{{ siteName }}</span>
            </a>
            {% endblock %}
            {{ block('header_menu') }}
            {{ block('header_actions') }}
        </div>
    </nav>
    {% endblock %}
    {{ block('header_breadcrumbs') }}
</div>
{% endblock %}
