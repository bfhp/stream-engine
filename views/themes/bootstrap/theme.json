{
  "id": "bootstrap",
  "name": "Bootstrap",
  "version": "1",
  "parent": "default",
  "inheritAssets": false,
  "themeColor": "#0F172A",
  "settings": {
    "color_mode": {
      "type": "select",
      "label": "Color mode",
      "default": "dark",
