{
  "id": "bootstrap",
  "name": "Bootstrap",
  "version": "1",
  "parent": "default",
  "themeColor": "#0F172A",
  "settings": {
    "color_mode": {
      "type": "select",
      "label": "Color mode",
      "default": "dark",
      "options": {
        "dark": "Dark",
        "light": "Light"
      }
    }
  },
  "assets": {
    "styles": [
      "/assets/css/bootstrap.css"
    ],
    "scripts": [
      "/assets/js/ui-bootstrap.js"
    ],
    "rtl": {
      "/assets/css/bootstrap.css": "/assets/css/bootstrap-rtl.css"
    }
  }
}
