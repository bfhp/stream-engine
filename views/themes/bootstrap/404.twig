{% extends '@default/404.twig' %}

{% block main_class %}pt-5 pb-5 not-found-page{% endblock %}
{% block not_found_container_class %}container text-center{% endblock %}

{% block not_found_title %}
    <h1 class="display-3">{{ trans('view.not_found.title') }}</h1>
{% endblock %}

{% block not_found_text %}
    <p class="lead">
        {{ trans('view.not_found.text') }}
    </p>
{% endblock %}

{% block not_found_actions %}
    <a href="/" class="btn btn-primary">
        {{ trans('view.not_found.home') }}
    </a>
{% endblock %}
