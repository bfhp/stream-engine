<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir|default('ltr') }}" data-bs-theme="{{ theme.values.color_mode|default('dark') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ status }} — {{ title }}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <meta name="theme-color" content="{{ theme.themeColor|default('#0F172A') }}">
    {% for asset in theme.assets.styles|default(['/assets/css/site.css']) %}
        <link rel="stylesheet" href="{{ asset }}">
    {% endfor %}
</head>
<body>
<main class="container py-5 text-center">
    <h1 class="display-3">{{ status }}</h1>
    <h2>{{ title }}</h2>
    <p class="lead">{{ message }}</p>
    <a href="/" class="btn btn-dark">{{ trans('error.home') }}</a>
</main>
</body>
</html>
