<section id="comments" class="{% block comments_section_class %}comments-section{% endblock %}" data-parent-id="{{ feed.id }}">
    {% block comments_header %}
        <div class="comments-header">
            <h2>{{ trans('view.comments.title') }}</h2>
            {% if comments.meta.total is defined %}
                <span class="ui-badge">{{ comments.meta.total }}</span>
            {% endif %}
        </div>
    {% endblock %}

    {% if user.isGuest %}
        {% block comments_auth_hint %}
            <div class="comments-auth-hint ui-alert">
                <span>{{ trans('view.comments.sign_in_hint') }}</span>
                <button type="button"
                        class="ui-button ui-button--primary ui-button--sm"
                        data-ui-toggle="modal"
                        data-ui-target="#authFormModal">
                    {{ trans('view.auth.sign_in') }}
                </button>
            </div>
        {% endblock %}
    {% else %}
        {% block comments_form %}
            <div class="comment-compose ui-card">
                <div class="ui-card__body">
                    {% include 'components/comments/form.twig' with {
                        parentId: feed.id,
                        mode: 'root',
                        placeholder: trans('view.comments.publication_placeholder'),
                        submitLabel: trans('view.comments.submit_comment')
                    } %}
                </div>
            </div>
        {% endblock %}
    {% endif %}

    {% block comments_list %}
    <div id="comments-list" class="comments-list">

        {% for comment in comments.items %}
            {% block comments_list_item %}
                {% include 'components/comments/comment.twig' with { comment: comment } %}
            {% endblock %}
        {% endfor %}

    </div>
    {% endblock %}

    {% block comments_load_more %}
        {% if comments.meta.next_cursor %}
            <button id="load-more-comments"
                    type="button"
                    class="load-more-comments ui-button ui-button--secondary ui-button--block"
                    data-parent-id="{{ feed.id }}"
                    data-next-cursor="{{ comments.meta.next_cursor ?? '' }}"
            >
                {{ trans('view.comments.load_more', {count: comments.meta.next_count}) }}
            </button>
        {% endif %}
    {% endblock %}

</section>
