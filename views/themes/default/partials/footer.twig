<footer class="{% block footer_class %}site-footer{% endblock %}">
    {% block footer_inner %}
    <div class="ui-container">
        <div class="site-footer__grid">

            {# --- LEFT --- #}
            <div class="site-footer__about">
                {% block footer_about %}
                    {% include 'components/widgets/block.twig' with { placement: 'footer_legal' } %}
                    <p>
                    {{ trans('view.footer.copyright', {year: "now"|date("Y"), site: siteName}) }}
                    </p>
                    {% block footer_runtime %}
                        {{ runtime }}
                    {% endblock %}
                {% endblock %}
            </div>
            <div class="footer-quick-links">
                {% block footer_menu %}
                <h2 class="site-footer__title">{{ trans('view.footer.quick_links') }}</h2>
                    {% if bottomMenu %}
                        {% include 'components/nav/menu.twig' with {
                            items: bottomMenu,
                            menuClass: 'site-footer__links',
                            itemClass: 'site-footer__link'
                        } %}
                    {% endif %}
                {% endblock %}
            </div>
            <div class="site-footer__contacts">
                {% block footer_contacts %}
                    {% include 'components/widgets/block.twig' with { placement: 'footer_contacts' } %}
                {% endblock %}
            </div>
        </div>
    </div>
    {% endblock %}
</footer>
