<footer class="text-light py-5 mt-auto">
    {% block footer_inner %}
    <div class="pb-5">
        <div class="container">
            <div class="row">

                {# --- LEFT --- #}
                <div class="col-md-6">
                    {% block footer_about %}
                        <p>
                            {{ trans('view.footer.terms_prefix') }} <a href="/rules/">{{ trans('view.footer.rules') }}</a>.
                        </p>
                        <p>
                        {{ trans('view.footer.copyright', {year: "now"|date("Y"), site: site_name}) }}
                        </p>
                        {% block footer_runtime %}
                            {{ runtime }}
                        {% endblock %}
                    {% endblock %}
                </div>
                <div class="col-md-3 footer-quick-links">
                    {% block footer_menu %}
                    <h2>{{ trans('view.footer.quick_links') }}</h2>
                        {% if bottomMenu %}
                            {% include 'components/nav/menu.twig' with {
                                items: bottomMenu,
                                menuClass: 'list-group',
                                itemClass: 'list-group-item list-group-item-action'
                            } %}
                        {% endif %}
                    {% endblock %}
                </div>
                <div class="col-md-3">
                    {% block footer_contacts %}
                        {% include 'components/widgets/block.twig' with { placement: 'footer_contacts' } %}
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
    {% endblock %}
</footer>
