<header class="{% block header_class %}site-header{% endblock %}">
    {% block header_inner %}
    <div class="layout-wrapper ui-container">
        {% block header_navbar %}
        <nav class="site-nav">
            {% block header_logo %}
            <a href="/" class="site-nav__brand">
                {% if headerLogo %}
                    <img class="header-logo" src="{{ headerLogo }}" alt=""
                        {%- if headerLogoSize|default(null) %} width="{{ headerLogoSize.width }}" height="{{ headerLogoSize.height }}" style="--header-logo-block-size: min({{ headerLogoSize.height }}px, 2.5rem)"{% endif %}>
                {% endif %}
                <span>{{ siteName }}</span>
            </a>
            {% endblock %}
            {% block header_menu %}
                {% include 'components/nav/navbar.twig' %}
            {% endblock %}
            {% block header_actions %}
                {% include 'partials/navbar-user.twig' %}
            {% endblock %}
        </nav>
        {% endblock %}
        {% block header_breadcrumbs %}
            {% if breadcrumbs %}
            {% include 'components/nav/breadcrumbs.twig' %}
            {% endif %}
        {% endblock %}
    </div>
    {% endblock %}
</header>
