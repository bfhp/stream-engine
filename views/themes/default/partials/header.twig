<header class="{% block header_class %}site-header{% endblock %}">
    {% block header_inner %}
    <div class="layout-wrapper ui-container">
        {% block header_navbar %}
        <nav class="site-nav">
            {% block header_logo %}
            <a href="/" class="site-nav__brand">{{ siteName }}</a>
            {% endblock %}
            {% block header_menu %}
                {% include 'components/nav/navbar.twig' %}
            {% endblock %}
            {% block header_actions %}
                {% include 'partials/navbar-user.twig' %}
            {% endblock %}
        </nav>
        {% endblock %}
        {% block header_breadcrumbs %}
            {% if breadcrumbs %}
            {% include 'components/nav/breadcrumbs.twig' %}
            {% endif %}
        {% endblock %}
    </div>
    {% endblock %}
</header>
