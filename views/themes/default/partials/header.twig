<header class="text-light sticky-top shadow-sm">
    {% block header_inner %}
    <div class="layout-wrapper container">
        {% block header_navbar %}
        <nav class="navbar navbar-expand-lg">
            {# Top row #}
            <div class="container-fluid d-flex align-items-center">
                {% block header_logo %}
                <a href="/" class="navbar-brand d-flex align-items-center order-1">
                    <span class="fw-semibold">{{ site_name }}</span>
                </a>
                {% endblock %}
                {% block header_menu %}
                    {% include 'components/nav/navbar.twig' %}
                {% endblock %}
                {% block header_actions %}
                    {% include 'partials/navbar-user.twig' %}
                {% endblock %}
            </div>
        </nav>
        {% endblock %}
        {% block header_breadcrumbs %}
            {% if breadcrumbs %}
            {% include 'components/nav/breadcrumbs.twig' %}
            {% endif %}
        {% endblock %}
    </div>
    {% endblock %}
</header>
