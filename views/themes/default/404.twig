{% extends "layouts/simple.twig" %}

{% block main_class %}layout-main not-found-page{% endblock %}

{% block content %}
    {% block not_found_container %}
        <div class="{% block not_found_container_class %}ui-container status-page{% endblock %}">

            {% block not_found_title %}
                <h1 class="status-page__title">{{ trans('view.not_found.title') }}</h1>
            {% endblock %}

            <hr>

            {% block not_found_text %}
                <p class="status-page__lead">
                    {{ trans('view.not_found.text') }}
                </p>
            {% endblock %}

            {% block not_found_actions %}
                <a href="/" class="ui-button ui-button--primary">
                    {{ trans('view.not_found.home') }}
                </a>
            {% endblock %}

        </div>
    {% endblock %}
{% endblock %}
