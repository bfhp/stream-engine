<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir|default('ltr') }}" data-date-format="{{ dateFormat|default('auto') }}" data-time-format="{{ timeFormat|default('auto') }}" {% block html_attributes %}data-color-mode="{{ theme.values.color_mode|default('dark') }}"{% endblock %}>
{% block layout_head %}
<head>
    <meta charset="utf-8">

    {% block head_meta %}
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# A page without its own description falls back to its title: an
           empty description is worse for search snippets than a short one.
           meta_description strips tags and cuts to 255 characters with "…". #}
        <meta name="description" content="{% block description %}{{ (description|default('') ?: title|default(''))|meta_description }}{% endblock %}" />
    {% endblock %}

    <title>{% block meta_title %}{{ title|default('') }}{% endblock %}</title>

    {% block head_icons %}
        {% include 'partials/site-icons.twig' %}
    {% endblock %}

    {% block head_theme %}
        <meta name="theme-color" content="{{ theme.values.color_mode|default('dark') == 'light' ? '#F8FAFC' : theme.themeColor|default('#0F172A') }}">
    {% endblock %}

    {% include 'partials/color-mode.twig' %}

    {# Built assets (Core\Assets): the theme's Vite entries and the page's own
       (`entries` from the controller), with their stylesheets, preloads and
       scripts, then the theme's static stylesheets. The import map goes
       first: the modules resolve their translations through it. #}
    {% block head_assets %}
        {{ asset_import_map() }}
        {{ asset_tags(theme.assets.entries|default([])|merge(entries|default([]))) }}
        {% for asset in theme.assets.styles|default([]) %}
            <link rel="stylesheet" href="{{ asset }}">
        {% endfor %}
    {% endblock %}

    {% if canonical and siteUrl %}
        <link rel="canonical" href="{{ siteUrl }}{{ canonical }}">
    {% endif %}

    {% block head_og %}
        <meta property="og:title" content="{{ title|default('') }}" />
        <meta property="og:description" content="{{ (description|default('') ?: title|default(''))|meta_description }}" />
        {% if canonical and siteUrl %}
        <meta property="og:url" content="{{ siteUrl }}{{ canonical }}" />
        {% endif %}
        <meta property="og:site_name" content="{{ siteName }}" />
        {% if image and siteUrl %}
            <meta property="og:image" content="{{ siteUrl }}{{ image }}" />
        {% endif %}
    {% endblock %}

    {% block head_ext %}
        {% for item in head_ext %}
            {{ item|raw }}
        {% endfor %}
    {% endblock %}
    {% block head_widgets %}
        {{ widgets.head|default('')|raw }}
    {% endblock %}
</head>
{% endblock %}

<body data-auth="{% if user.isGuest %}0{% else %}1{% endif %}">

{% block skip_link %}
    <a class="ui-skip-link" href="#main-content">{{ trans('view.nav.skip_to_content') }}</a>
{% endblock %}

{% block layout_header %}
    {% include 'partials/header.twig' %}
{% endblock %}

{% block layout_after_header %}
    {% include 'components/widgets/block.twig' with { placement: 'after_header' } %}
{% endblock %}

{% block layout_main %}
{% endblock %}

{% block layout_footer %}
    {% include 'partials/footer.twig' %}
{% endblock %}

{% block layout_auth %}
    {% include 'partials/auth-modal.twig' %}
{% endblock %}

{% block layout_overlays %}
    {% block ui_toast %}
        {% include 'components/ui/toast.twig' %}
    {% endblock %}

    {% block ui_modal_confirm %}
        {% include 'components/ui/modal_confirm.twig' %}
    {% endblock %}

    {% block ui_templates %}
        {% include 'partials/js-templates.twig' %}
    {% endblock %}
{% endblock %}
{% block layout_cookie_notice %}
    {% if cookieNotice|default(false) %}
        {% include 'partials/cookie-notice.twig' %}
    {% endif %}
{% endblock %}
{% block body_end %}{% endblock %}
</body>
</html>
