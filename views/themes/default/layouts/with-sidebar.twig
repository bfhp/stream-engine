{% extends "layouts/base.twig" %}

{% block layout_main %}

<main class="{% block main_class %}layout-main{% endblock %}">
    {% block layout_wrapper %}
    <div class="layout-wrapper">
        <div class="{% block layout_container_class %}ui-container{% endblock %}">
            {% block layout_row %}
                <div class="{% block layout_row_class %}layout-sidebar{% endblock %}">

                    <div class="{% block layout_content_class %}layout-sidebar__content{% endblock %}">
                        {% include 'components/widgets/block.twig' with { placement: 'before_content' } %}
                        {% block content %}{% endblock %}
                        {% include 'components/widgets/block.twig' with { placement: 'after_content' } %}
                    </div>

                    <aside class="{% block layout_aside_class %}layout-sidebar__aside{% endblock %}">
                        {% block sidebar_inner %}
                            <div class="sidebar-sticky">
                                {% include 'components/widgets/block.twig' with { placement: 'sidebar_top' } %}
                                {% block sidebar_widgets %}{% endblock %}
                                {% include 'components/widgets/block.twig' with { placement: 'sidebar_bottom' } %}
                            </div>
                        {% endblock %}
                    </aside>
                </div>
            {% endblock %}
        </div>
    </div>
    {% endblock %}
</main>
{% endblock %}
