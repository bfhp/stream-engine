{% extends "layouts/base.twig" %}

{% block layout_main %}
    <main class="{% block main_class %}layout-main{% endblock %}">
        <div class="{% block layout_container_class %}ui-container{% endblock %}">
            {% include 'components/widgets/block.twig' with { placement: 'before_content' } %}
            {% block content %}{% endblock %}
            {% include 'components/widgets/block.twig' with { placement: 'after_content' } %}
        </div>
    </main>
{% endblock %}
