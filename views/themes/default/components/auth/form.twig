<dialog class="ui-modal" id="authFormModal" aria-labelledby="authFormTitle">

    {% block auth_modal_dialog %}

        {% block auth_header %}
            <div class="ui-modal__header">
                <h2 class="ui-modal__title" id="authFormTitle">{% block auth_title %}{{ trans('view.auth.title') }}{% endblock %}</h2>
                <button type="button" class="ui-close" data-ui-dismiss="modal" aria-label="{{ trans('view.ui.close') }}">&times;</button>
            </div>
        {% endblock %}

        {% block auth_body %}
            <div class="ui-modal__body">

                {% block auth_form %}
                    <form id="authForm" method="post">

                        {% block auth_fields %}

                            {% block auth_field_email %}
                                <div class="ui-field">
                                    <label for="authEmail" class="ui-label">Email</label>
                                    <input autocomplete="yes" type="email" class="ui-input" id="authEmail" name="email" required>
                                </div>
                            {% endblock %}

                            {% block auth_field_password %}
                                <div class="ui-field">
                                    <label for="authPassword" class="ui-label">{{ trans('view.auth.password') }}</label>
                                    <input autocomplete="yes" type="password" class="ui-input" id="authPassword" name="password" required>
                                </div>
                            {% endblock %}

                        {% endblock %}

                        {% block auth_forgot %}
                            {% set passwordRecoveryUrl = action_url('user.retrieve') %}
                            {% if passwordRecoveryUrl %}
                            <p class="ui-field ui-small auth-forgot">
                                <a href="{{ passwordRecoveryUrl }}">{{ trans('view.auth.forgot_password') }}</a>
                            </p>
                            {% endif %}
                        {% endblock %}

                        {% block auth_submit %}
                            <button type="submit" class="ui-button ui-button--primary ui-button--block">
                                {{ trans('view.auth.sign_in') }}
                            </button>
                        {% endblock %}

                    </form>
                {% endblock %}

                {% block auth_footer %}
                    {% set registerUrl = action_url('user.register') %}
                    {% if registerUrl and registrationOpen|default(true) %}
                    <p class="auth-footer">
                        {{ trans('view.auth.no_account') }}
                        <a href="{{ registerUrl }}">{{ trans('view.auth.register') }}</a>
                    </p>
                    {% endif %}
                {% endblock %}
            </div>
        {% endblock %}

    {% endblock %}
</dialog>
