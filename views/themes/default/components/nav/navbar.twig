{% block navbar_burger %}
    {# BURGER: shown below the desktop breakpoint only (base.css) #}
    <button class="ui-button ui-button--secondary site-nav__burger"
            type="button"
            data-ui-toggle="collapse"
            data-ui-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="{{ trans('view.nav.open_menu') }}">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>
{% endblock %}

{# Menu #}
<div class="site-nav__collapse" id="mainNavbar" hidden>
    {% block navbar_menu %}
        {% include 'components/nav/menu.twig' with {
            items: topMenu,
            menuClass: 'site-nav__menu',
            itemClass: 'site-nav__link'
        } %}
    {% endblock %}

    {% block navbar_search %}
        {% include 'components/nav/search-form.twig' %}
    {% endblock %}
</div>
