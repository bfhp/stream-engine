{% set searchUrl = action_url('search.results') %}
{% if searchUrl %}
    <form class="site-nav__search" role="search" method="get" action="{{ searchUrl }}">
        <input class="ui-input" required name="q" minlength="3" type="search" placeholder="{{ trans('view.nav.search') }}" aria-label="{{ trans('view.nav.search') }}"/>
        <button class="ui-button ui-button--secondary" type="submit" aria-label="{{ trans('view.nav.search') }}"><i class="bi bi-search" aria-hidden="true"></i></button>
    </form>
{% endif %}
