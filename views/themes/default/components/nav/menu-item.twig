{% set level = level|default(0) %}
{% set itemClass = itemClass|default('site-nav__link') %}

{# --- DIVIDER --- #}
{% if item.isDivider %}
    <li class="site-nav__divider" role="separator"></li>

{# --- LINK / ACTION --- #}
{% else %}

    {% set hasChildren = item.children is not empty %}

    <li class="site-nav__item">

        <a
                class="{{ level == 0 ? itemClass : 'site-nav__link' }}{{ item.active ? ' active' : '' }}"
                href="{{ item.isLink ? item.url : '#'}}"

                {% if item.type == 'action' %}
                    data-{{ item.action }}
                {% endif %}

                {% if item.isExternal %}
                    target="_blank" rel="noopener noreferrer"
                {% endif %}

                {% if hasChildren %}
                    id="menu-{{ item.id }}"
                    aria-haspopup="true"
                {% endif %}
        >
            {{ item.label }}
        </a>

        {# --- CHILDREN: shown on hover/focus by CSS, no script needed --- #}
        {% if hasChildren %}
            <ul class="site-nav__submenu" aria-labelledby="menu-{{ item.id }}">
                {% for child in item.children %}
                    {% include 'components/nav/menu-item.twig' with {
                        item: child,
                        level: level + 1
                    } %}
                {% endfor %}
            </ul>
        {% endif %}

    </li>

{% endif %}
