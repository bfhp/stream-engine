{% set messagesUrl = action_url('messages.inbox') %}
{% set profileUrl = action_url('profile.show') %}
<div class="site-nav__user">

    {% block user_messages %}
        {% if messagesUrl %}
            <a class="ui-button ui-button--secondary" href="{{ messagesUrl }}" data-messages-link title="{{ trans('view.nav.messages') }}">
                <i class="bi bi-envelope" aria-hidden="true"></i>
                <span class="ui-visually-hidden">{{ trans('view.nav.messages') }}</span>
            </a>
        {% endif %}
    {% endblock %}

    {% block user_dropdown %}
        {% if profileUrl %}
            <a id="menu-user" href="{{ profileUrl }}" title="{{ trans('view.nav.profile') }}">
                <img alt="{{ user.nick }}"
                     src="{{ user.avatarUrl }}"
                     class="site-nav__avatar" />
            </a>
        {% endif %}

        {# <details> opens and closes without a script. #}
        <details class="ui-dropdown">
            <summary id="menu-user-toggle"
                     class="ui-button ui-button--secondary ui-button--sm"
                     aria-label="{{ trans('view.nav.open_menu') }}">
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </summary>
            <ul class="ui-dropdown__menu" aria-labelledby="menu-user-toggle">
                {% block navbar_user_menu %}
                    {% for item in userMenu %}
                        {% include 'components/nav/menu-item.twig' with {
                            item: item,
                            level: 1
                        } %}
                    {% endfor %}
                {% endblock %}
            </ul>
        </details>
    {% endblock %}
</div>
