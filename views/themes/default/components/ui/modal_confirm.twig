{# Global confirm dialog - filled and opened by CMS.confirm() (site/app.ts). #}
<dialog class="ui-modal" id="globalConfirmModal" aria-labelledby="globalConfirmTitle">
    <div class="ui-modal__header">
        <h2 class="ui-modal__title" id="globalConfirmTitle">{{ trans('view.ui.confirmation') }}</h2>
        <button type="button" class="ui-close" data-ui-dismiss="modal" aria-label="{{ trans('view.ui.close') }}">&times;</button>
    </div>
    <div class="ui-modal__body" id="globalConfirmBody">
        {{ trans('view.ui.are_you_sure') }}
    </div>
    <div class="ui-modal__footer">
        <button type="button" class="ui-button ui-button--secondary" data-ui-dismiss="modal">
            {{ trans('view.comments.cancel') }}
        </button>
        <button type="button" class="ui-button ui-button--danger" id="globalConfirmOk">
            {{ trans('view.ui.confirm') }}
        </button>
    </div>
</dialog>
