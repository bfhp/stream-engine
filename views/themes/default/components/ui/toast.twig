{# Global toast - filled and shown by CMS.toast() (site/app.ts). Screen
   readers hear it through the announcer in shared/ui.ts, so it has no live
   role of its own. #}
<div class="ui-toast-region">
    <div id="globalToast" class="ui-toast" hidden>
        <div class="ui-toast__body" id="globalToastBody">
            {{ trans('view.ui.message') }}
        </div>
        <button type="button" class="ui-close" data-ui-dismiss="toast" aria-label="{{ trans('view.ui.close') }}">&times;</button>
    </div>
</div>
