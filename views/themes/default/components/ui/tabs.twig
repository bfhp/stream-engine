{# Tabs switched by shared/ui.ts (data-ui-toggle="tab"), which dispatches
   `ui:tab-shown` on the tab - assets-src/pages/profile.ts listens for it to
   load the friends list on first switch to that tab. #}
<div class="ui-tabs" role="tablist">

    {% for tab in tabs %}
        <button class="ui-tabs__tab"
                type="button"
                role="tab"
                id="{{ tab.id }}-tab"
                aria-controls="{{ tab.id }}"
                aria-selected="{{ loop.first ? 'true' : 'false' }}"
                data-ui-toggle="tab"
                data-ui-target="#{{ tab.id }}">
            {{ tab.label }}
        </button>
    {% endfor %}

</div>
