{# data-slot* attributes are fill points for the browser: partials/js-templates.twig
   renders this same file as a <template>, and site/app.ts fills it for comments
   loaded or posted without a page reload (see shared/ui.ts fill()). #}
<article class="comment ui-card" data-id="{{ comment.id }}" data-slot-attr="data-id:id">
    <div class="ui-card__body">

        {% block comment_header %}
            <div class="comment-meta">
                {% block comment_avatar %}
                    <img
                        src="{{ comment.authorAvatarUrl }}"
                        alt="{{ comment.authorDisplayName }}"
                        class="comment-avatar"
                        width="44"
                        height="44"
                        data-slot-attr="src:avatar alt:author"
                    >
                {% endblock %}
                {% block comment_meta %}
                    <div class="comment-meta-text">
                        <div class="comment-author"><bdi data-slot="author">{{ comment.authorDisplayName }}</bdi></div>
                        {% if comment.createdAtLabel %}
                            <time class="comment-date"
                                  datetime="{{ comment.createdAt ? comment.createdAt|date('c') : '' }}"
                                  {% if comment.createdAtTitle %}title="{{ comment.createdAtTitle }}"{% endif %}
                                  data-slot="date"
                                  data-slot-attr="datetime:datetime title:dateTitle"
                                  data-slot-optional="date">
                                {{ comment.createdAtLabel }}
                            </time>
                        {% endif %}
                    </div>
                {% endblock %}
            </div>
        {% endblock %}

        {% block comment_content %}
            <div class="comment-content content" dir="auto" data-slot-html="content">
                {{ comment.content|raw }}
            </div>
        {% endblock %}

        {% block comment_actions %}
            <div class="comment-actions">
                {% if user.isGuest %}
                    <button type="button"
                            class="ui-button ui-button--link ui-button--sm"
                            data-ui-toggle="modal"
                            data-ui-target="#authFormModal">
                        {{ trans('view.comments.reply') }}
                    </button>
                {% else %}
                    <button type="button" class="ui-button ui-button--link ui-button--sm" data-reply-toggle>
                        {{ trans('view.comments.reply') }}
                    </button>
                {% endif %}
            </div>
        {% endblock %}

        {% block comment_reply_form %}
            {% if not user.isGuest %}
                <div class="comment-reply-form-wrapper" hidden>
                    {% include 'components/comments/form.twig' with {
                        parentId: comment.id,
                        mode: 'reply',
                        formClass: 'comment-form comment-form-reply',
                        placeholder: trans('view.comments.reply_placeholder'),
                        submitLabel: trans('view.comments.reply'),
                        rows: 2
                    } %}
                </div>
            {% endif %}
        {% endblock %}

        {% block comment_replies %}
            <div class="replies">{% if comment.children %}
                {% for reply in comment.children.items %}
                    {% include 'components/comments/reply.twig' with { reply: reply } %}
                {% endfor %}

                {% block comment_replies_load_more %}
                    {% if comment.children.meta.next_cursor %}
                        {% include 'components/comments/load-replies.twig' with {
                            parentId: comment.id,
                            nextCursor: comment.children.meta.next_cursor ?? '',
                            label: trans('view.comments.load_more', {count: comment.children.meta.next_count})
                        } %}
                    {% endif %}
                {% endblock %}
            {% endif %}</div>
        {% endblock %}
    </div>
</article>
