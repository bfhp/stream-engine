<form class="{{ formClass|default('comment-form') }}"
      data-comment-form
      data-parent-id="{{ parentId }}"
      data-comment-mode="{{ mode|default('root') }}"
      data-slot-attr="data-parent-id:id">
    {% block comment_form_body %}
        <div class="comment-form-field">
            <label class="ui-visually-hidden" for="comment-content-{{ mode|default('root') }}-{{ parentId }}" data-slot-attr="for:inputId">{{ trans('view.comments.comment') }}</label>
            <textarea
                id="comment-content-{{ mode|default('root') }}-{{ parentId }}"
                class="ui-input"
                name="content"
                rows="{{ rows|default(3) }}"
                placeholder="{{ placeholder|default(trans('view.comments.placeholder')) }}"
                maxlength="5000"
                required
                data-slot-attr="id:inputId"
            ></textarea>
        </div>
    {% endblock %}

    {% block comment_form_error %}
        <div class="comment-form-error ui-error" data-comment-form-error hidden></div>
    {% endblock %}

    {% block comment_form_actions %}
        <div class="comment-form-actions">
            <button type="submit" class="ui-button ui-button--primary ui-button--sm">
                {{ submitLabel|default(trans('view.comments.submit')) }}
            </button>

            {% if mode == 'reply' %}
                <button type="button" class="ui-button ui-button--secondary ui-button--sm" data-comment-cancel>
                    {{ trans('view.comments.cancel') }}
                </button>
            {% endif %}
        </div>
    {% endblock %}
</form>
