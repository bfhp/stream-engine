<article class="reply" id="comment-{{ reply.id }}" data-id="{{ reply.id }}" data-slot-attr="data-id:id id:anchor">
    {% block reply_header %}
        <div class="comment-meta">
            {% block reply_avatar %}
                <img
                    src="{{ reply.authorAvatarUrl }}"
                    alt=""
                    class="comment-avatar"
                    width="32"
                    height="32"
                    data-slot-attr="src:avatar"
                >
            {% endblock %}
            {% block reply_meta %}
                <div class="comment-meta-text">
                    <div class="comment-author"><a href="{{ reply.authorUrl }}" class="comment-author-link" data-slot-attr="href:authorUrl"><bdi data-slot="author">{{ reply.authorDisplayName }}</bdi></a></div>
                    {% if reply.createdAtLabel %}
                        <time class="comment-date"
                              datetime="{{ reply.createdAt ? reply.createdAt|date('c') : '' }}"
                              {% if reply.createdAtTitle %}title="{{ reply.createdAtTitle }}"{% endif %}
                              data-slot="date"
                              data-slot-attr="datetime:datetime title:dateTitle"
                              data-slot-optional="date">
                            {{ reply.createdAtLabel }}
                        </time>
                    {% endif %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}

    {% block reply_content %}
        <div class="reply-content" dir="auto" data-slot-html="content">
            {{ reply.content|raw }}
        </div>
    {% endblock %}
</article>
