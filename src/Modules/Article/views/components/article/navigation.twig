{% if siblings.prev or siblings.next %}
    <nav class="ui-container article-nav">

        {% if siblings.prev %}
            <a class="ui-button ui-button--primary article-nav__prev"
               href="{{ siblings.prev.canonicalUrl }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                {{ siblings.prev.title }}
            </a>
        {% endif %}

        {% if siblings.next %}
            <a class="ui-button ui-button--primary article-nav__next"
               href="{{ siblings.next.canonicalUrl }}">
                {{ siblings.next.title }}
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        {% endif %}

    </nav>
{% endif %}
