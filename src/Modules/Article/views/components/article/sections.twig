{% if items %}
    <div class="ui-container article-sections">
        {% for item in items %}
            <section class="ui-card article-section">
                <h3 class="article-section__title">{{ item.position }}. <a href="{{ item.canonicalUrl }}">{{ item.title }}</a></h3>
                {% if item.children %}
                    <ol class="article-section__list">
                        {% for child in item.children %}
                            <li><a href="{{ child.canonicalUrl }}">{{ child.title }}</a></li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>
        {% endfor %}
    </div>
{% endif %}
