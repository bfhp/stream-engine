{% if items %}
    <div class="container">
        <div class="row">

            {% for item in items %}
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">{{ item.position }}. <a href="{{item.canonicalUrl}}">{{item.title}}</a></h5>
                        </div>
                        {% if item.children %}
                        <div class="card-body">
                            <ol>
                                {% for child in item.children %}
                                <li><a href="{{child.canonicalUrl}}">{{ child.title }}</a></li>
                                {% endfor %}
                            </ol>
                        </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}