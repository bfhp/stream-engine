<article class="ui-card article-card">
    <div class="ui-card__body">
        <h3 class="ui-card__title">{{ item.title }}</h3>

        <p class="ui-muted">
            {{ item.description }}
        </p>

        <a href="{{ item.canonicalUrl }}"
           class="ui-button ui-button--primary"
           aria-label="{{ trans('view.article.read_aria', {title: item.title}) }}">
            {{ trans('view.article.card.01') }}
        </a>
    </div>
</article>
