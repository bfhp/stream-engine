<article class="ui-card article-card">
    <div class="ui-card__body">
        <h3 class="ui-card__title">{{ item.title }}</h3>

        <p class="ui-muted">
            {{ item.description }}
        </p>

        {# The name starts with the visible words (WCAG 2.5.3); the hidden title tells the links apart. #}
        <a href="{{ item.canonicalUrl }}" class="ui-button ui-button--primary">
            {{ trans('view.article.card.01') }}<span class="ui-visually-hidden">: {{ item.title }}</span>
        </a>
    </div>
</article>
