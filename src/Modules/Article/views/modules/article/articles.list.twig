{% extends "layouts/simple.twig" %}

{% block content %}

    {% block article_content %}
        {{ feed.content|raw }}
    {% endblock %}

    {% block article_related %}
        {% include 'components/article/related.twig' with { items: subFeeds } %}
    {% endblock %}

    {% if pagination and pagination.total > 1 %}
        {% include 'components/article/pagination.twig' with { pagination: pagination } %}
    {% endif %}

    {% block article_share %}
        {% include 'partials/share-buttons.twig' %}
    {% endblock %}

{% endblock %}
