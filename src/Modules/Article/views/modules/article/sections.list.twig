{% extends "layouts/simple.twig" %}

{% block content %}

    {% block article_content %}
        {{ feed.content|raw }}
    {% endblock %}

    {% block article_sections %}
        {% if sections %}
            {% include 'components/article/sections.twig' with { items: sections } %}
        {% endif %}
    {% endblock %}

    {% if pagination.total > 1 %}
        {% include 'components/article/pagination.twig' with { pagination: pagination } %}
    {% endif %}

    {% block article_share %}
        {% include 'partials/share-buttons.twig' %}
    {% endblock %}

{% endblock %}
