<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir|default('ltr') }}" data-date-format="{{ dateFormat|default('auto') }}" data-time-format="{{ timeFormat|default('auto') }}" data-mantine-color-scheme="light">
<head>
    <title>{{ title }}</title>
    <meta charset="utf-8">
    {# Without it phones lay the panel out at ~980px and scale it down, so
       Mantine's narrow layout never applies (WCAG 1.4.10). #}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <script>
        try {
            document.documentElement.setAttribute(
                "data-mantine-color-scheme",
                window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
            );
        } catch (error) {}
    </script>
    <link rel="stylesheet" href="/assets/css/admin.css">
    <link rel="stylesheet" href="/assets/css/custom-content.css">
    {% include '@default/partials/site-icons.twig' %}
</head>
<body>

<div id="root"></div>

<script defer type="module" src="/assets/js/admin.js"></script>

</body>
</html>
