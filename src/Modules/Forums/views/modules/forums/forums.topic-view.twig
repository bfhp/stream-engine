{% extends "layouts/simple.twig" %}

{# Framework-free markup; styles in assets-src/site/modules/forums.css. A
   theme restyles it by overriding this file (see
   views/themes/bootstrap/modules/forums/). Keep the data-* hooks and ids:
   assets-src/pages/forums.ts and forum-poll.ts drive them, toggling the
   `hidden` attribute. #}

{% block content %}
    <div class="ui-container forums-page">

        <div class="forums-header">
            <div class="forums-header__text">
                {% if parentForum %}
                    <a href="{{ parentForum.canonicalUrl }}" class="section-eyebrow">{{ trans('view.forums.topic.list.01') }} {{ parentForum.title }}</a>
                {% endif %}
                <h1 class="forums-header__title" dir="auto"><bdi>{{ feed.title }}</bdi></h1>
                <div class="forums-topic-meta">
                    <span><i class="bi bi-person"></i><bdi>{{ feed.authorDisplayName }}</bdi></span>
                    {% if feed.createdAtTitle %}
                        <span title="{{ feed.createdAtTitle }}"><i class="bi bi-calendar3"></i>{{ feed.createdAtLabel }}</span>
                    {% endif %}
                    <span><i class="bi bi-chat-square-text"></i><span class="forums-number">{{ topicTotals.posts }}</span> {{ trans_choice('forums.post_unit', topicTotals.posts) }}</span>
                    <span><i class="bi bi-people"></i><span class="forums-number">{{ topicTotals.participants }}</span> {{ trans_choice('forums.participant', topicTotals.participants) }}</span>
                    <span><i class="bi bi-eye"></i><span class="forums-number">{{ topicTotals.views }}</span> {{ trans_choice('forums.view_unit', topicTotals.views) }}</span>
                    {% if poll %}
                        <a href="#topic-poll" class="link-quiet"><i class="bi bi-bar-chart-line"></i>{{ trans('view.forums.topic.form.10') }}</a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="forums-toolbar">
            {% if participants %}
                <div class="forums-participants">
                    <span>{{ trans('view.forums.topic.view.05') }}</span>
                    <span class="forums-participants__list">
                        {% for participant in participants %}
                            <img src="{{ participant.avatarUrl }}" alt="{{ participant.displayName }}" title="{{ participant.displayName }}"
                                 class="forums-avatar" width="26" height="26">
                        {% endfor %}
                        {% if participantsOverflow > 0 %}
                            <span class="forums-participants__more">+{{ participantsOverflow }}</span>
                        {% endif %}
                    </span>
                </div>
            {% else %}
                <div></div>
            {% endif %}
            <div class="forums-topic-actions">
                {# Whole-topic editor (forums.topic-edit: title + rich-text
                   opening post + poll + attachments), as opposed to the
                   per-post "Edit" further down, which can only change the
                   rich-text content.
                   Visibility comes from ForumsController::canEditTopic() -
                   literally the same assertTopicEditable() the edit page and
                   its PATCH endpoint enforce, so this button can't appear on
                   a topic those would refuse. #}
                {% if canEditTopic and topicEditUrl %}
                    <a href="{{ topicEditUrl }}" class="ui-button ui-button--secondary ui-button--sm">
                        <i class="bi bi-pencil-square"></i><span>{{ trans('view.forums.topic.view.06') }}</span>
                    </a>
                {% endif %}
                {% if canDeleteTopic %}
                    <button type="button" class="ui-button ui-button--secondary ui-button--sm forums-danger-link"
                            data-forum-topic-delete data-topic-id="{{ feed.id }}"
                            data-redirect-url="{{ parentForum ? parentForum.canonicalUrl : forumsListUrl }}">
                        <i class="bi bi-trash"></i><span>{{ trans('view.forums.topic.view.34') }}</span>
                    </button>
                {% endif %}
                {# Generic feed favoriting widget repurposed as "follow this
                   topic" - bell icon/"Follow" wording via the
                   data-favorite-*-on/off overrides CMS.updateFavoriteButton()
                   reads. Replying to a followed topic notifies every
                   follower - see ForumsController::notifyTopicFollowers(). #}
                <div class="forums-follow"
                     data-favorite-feed
                     data-feed-id="{{ feed.id }}"
                     data-favorited="{{ isFollowing ? '1' : '0' }}"
                     data-favorite-icon-on="bi-bell-fill"
                     data-favorite-icon-off="bi-bell"
                     data-favorite-label-on="{{ trans('view.forums.topic.view.07') }}"
                     data-favorite-label-off="{{ trans('view.forums.topic.view.08') }}"
                     data-favorite-aria-on="{{ trans('view.forums.topic.view.09') }}"
                     data-favorite-aria-off="{{ trans('view.forums.topic.form.45') }}">
                    {% if user.isGuest %}
                        <button type="button" class="ui-button ui-button--secondary ui-button--sm"
                                data-ui-toggle="modal" data-ui-target="#authFormModal">
                            <i class="bi bi-bell"></i><span>{{ trans('view.forums.topic.view.08') }}</span>
                        </button>
                    {% else %}
                        <button type="button" class="ui-button ui-button--secondary ui-button--sm"
                                data-favorite-toggle aria-pressed="{{ isFollowing ? 'true' : 'false' }}">
                            <i class="bi {{ isFollowing ? 'bi-bell-fill' : 'bi-bell' }}"></i>
                            <span data-favorite-label>{{ isFollowing ? trans('view.forums.topic.view.07') : trans('view.forums.topic.view.08') }}</span>
                        </button>
                    {% endif %}
                </div>
                <button type="button" class="ui-button ui-button--secondary ui-button--sm"
                        data-forum-mark-topic-read data-topic-id="{{ feed.id }}">
                    <i class="bi bi-check2-all"></i><span>{{ trans('view.forums.topic.view.10') }}</span>
                </button>
            </div>
        </div>

        {% if poll %}
            {# Generic feed-attached poll (Service\PollService). Vote-form and
               results are both always rendered (`hidden` per the *initial*
               showVoteForm/showResults state) so forum-poll.ts can toggle
               between them client-side. Option icons carry only their bi-*
               glyph; their color comes from forums.css by glyph. #}
            <section class="ui-card forums-section forums-poll" id="topic-poll" data-poll-feed-id="{{ feed.id }}">
                <div class="forums-section__header">
                    <div class="forums-poll__title">
                        <i class="bi bi-bar-chart-line"></i>
                        <h2 class="forums-section__heading">{{ trans('view.forums.topic.view.11') }}</h2>
                        {% if poll.isClosed %}
                            <span class="ui-badge">{{ trans('view.forums.topic.view.12') }}</span>
                        {% else %}
                            <span class="ui-badge ui-badge--success">{{ trans('view.forums.topic.view.13') }}</span>
                        {% endif %}
                    </div>
                    {% if poll.deadlineText %}
                        <div class="forums-poll__deadline">
                            <i class="bi bi-clock"></i><span>{{ poll.deadlineText }}</span>
                        </div>
                    {% endif %}
                </div>
                <div class="forums-poll__body">
                    <div class="forums-poll__question">{{ poll.question }}</div>
                    <div class="forums-poll__hint">{{ poll.hint }}</div>

                    <div class="forums-poll__options" {{ poll.showVoteForm ? '' : 'hidden' }}
                         data-poll-vote-form
                         data-poll-max-choices="{{ poll.maxChoices }}"
                         data-poll-multiple="{{ poll.isMultiple ? '1' : '0' }}"
                         data-poll-current-votes="{{ poll.currentVotesAttr }}">
                        {% for opt in poll.options %}
                            <label class="poll-option{{ opt.checked ? ' is-selected' : '' }}"
                                   data-poll-option data-option-id="{{ opt.id }}">
                                <input class="ui-visually-hidden" type="{{ poll.isMultiple ? 'checkbox' : 'radio' }}"
                                       name="poll-option-{{ poll.id }}" value="{{ opt.id }}"
                                       {{ opt.checked ? 'checked' : '' }} data-poll-option-input>
                                <i class="bi {{ poll.isMultiple
                                    ? (opt.checked ? 'bi-check-square-fill' : 'bi-square')
                                    : (opt.checked ? 'bi-record-circle' : 'bi-circle') }}" data-poll-option-icon></i>
                                <span>{{ opt.text }}</span>
                            </label>
                        {% endfor %}
                        <div class="forums-poll__actions">
                            <button type="button" class="ui-button ui-button--primary"
                                    data-poll-submit {{ poll.submitDisabled ? 'disabled' : '' }}>
                                <i class="bi bi-check2"></i><span>{{ trans('view.forums.topic.view.14') }}</span>
                            </button>
                            <button type="button" class="ui-button ui-button--secondary" hidden data-poll-cancel-change>{{ trans('view.comments.cancel') }}</button>
                            <span class="forums-poll__selection" data-poll-selection-hint>{{ poll.selectionHint }}</span>
                        </div>
                    </div>

                    <div {{ poll.showResults ? '' : 'hidden' }} data-poll-results>
                        {% for opt in poll.options %}
                            <div class="forums-poll__result">
                                <div class="forums-poll__result-head">
                                    <span class="forums-poll__result-text">
                                        <i class="bi {{ opt.checked ? 'bi-check-circle-fill' : 'bi-dot' }}"
                                           data-poll-option-result-icon data-option-id="{{ opt.id }}"></i><span>{{ opt.text }}</span>
                                    </span>
                                    <span class="forums-poll__stat"
                                          data-poll-option-stat data-option-id="{{ opt.id }}">{{ opt.statText }}</span>
                                </div>
                                <div class="forums-poll__track">
                                    <div class="forums-poll__fill{{ opt.checked ? ' is-chosen' : (opt.isLeading ? ' is-leading' : '') }}" style="width: {{ opt.pct }}%"
                                         data-poll-option-bar data-option-id="{{ opt.id }}"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% if poll.showHiddenNote %}
                        <div class="forums-poll__note" data-poll-hidden-note>
                            <i class="bi bi-eye-slash"></i><span>{{ poll.hiddenNoteText }}</span>
                        </div>
                    {% endif %}

                    <div class="forums-poll__footer">
                        <div class="forums-poll__totals">
                            <span {{ poll.showResults ? '' : 'hidden' }} data-poll-total-votes>
                                <i class="bi bi-check2-square"></i><span class="forums-number" data-poll-count>{{ poll.totalVotesText }}</span>
                            </span>
                            <span {{ poll.showResults ? '' : 'hidden' }} data-poll-voters>
                                <i class="bi bi-people"></i><span class="forums-number" data-poll-count>{{ poll.votersText }}</span>
                            </span>
                            <span class="forums-poll__voted" {{ poll.hasVoted ? '' : 'hidden' }} data-poll-voted-note>
                                <i class="bi bi-check-circle"></i><span>{{ trans('view.forums.topic.view.15') }}</span>
                            </span>
                        </div>
                        <button type="button" class="ui-button ui-button--link ui-button--sm" {{ poll.canChangeVote ? '' : 'hidden' }}
                                data-poll-change-vote>
                            <i class="bi bi-arrow-repeat"></i>{{ trans('view.forums.topic.view.16') }}
                        </button>
                    </div>

                    {% if poll.pollGuestPrompt %}
                        <div class="ui-alert forums-guest-prompt">
                            <span>{{ trans('view.forums.topic.view.17') }}</span>
                            <button type="button" class="ui-button ui-button--primary ui-button--sm" data-ui-toggle="modal" data-ui-target="#authFormModal">{{ trans('view.auth.sign_in') }}</button>
                        </div>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        <section class="ui-card forums-section">
            <div class="forums-section__header">
                <div class="forums-section__text">
                    <h2 class="forums-section__heading">{{ trans('view.forums.topic.view.18') }}</h2>
                    <div class="forums-section__sub">
                        {{ topicTotals.posts }} {{ trans_choice('forums.post_unit', topicTotals.posts) }}{{ trans('view.forums.topic.view.19') }} {{ pagination.current }} {{ trans('view.forums.topic.list.08') }} {{ pagination.total }}
                    </div>
                </div>
            </div>
            <div id="topic-posts">
                <ul class="forums-rows">
                    {% for post in posts %}
                        {% set postFeed = post.feed %}
                        <li class="forums-post" id="post-{{ postFeed.id }}">
                            <div class="forums-post__author">
                                <img src="{{ post.authorAvatarUrl }}" alt="{{ postFeed.authorDisplayName }}" class="forums-avatar" width="56" height="56">
                                <div class="forums-post__who">
                                    <span class="forums-post__name"><bdi>{{ postFeed.authorDisplayName }}</bdi></span>
                                    {% if post.isTopicAuthor %}
                                        <span class="ui-badge forums-post__badge forums-post__badge--author">{{ trans('view.forums.topic.view.20') }}</span>
                                    {% endif %}
                                    {% if post.isCurrentUser %}
                                        <span class="ui-badge forums-post__badge">{{ trans('view.forums.topic.view.21') }}</span>
                                    {% endif %}

                                    {# Post count / member-since: dropped on narrow
                                       screens, where this block sits next to the
                                       avatar instead of under it. #}
                                    <div class="forums-post__stats">
                                        <div>{{ trans('view.forums.topic.view.22') }} <span class="forums-number">{{ post.authorPostCount }}</span></div>
                                        {% if post.authorMemberSince %}
                                            <div>{{ trans('view.forums.topic.view.23') }} {{ post.authorMemberSince }}</div>
                                        {% endif %}
                                    </div>

                                    {# Generic feed rating widget - data-rate-feed/
                                       data-feed-id/data-user-rating are picked up by
                                       CMS.initRating(), called globally in main.ts. #}
                                    <div class="forums-post__rating"
                                         data-rate-feed
                                         data-feed-id="{{ postFeed.id }}"
                                         data-user-rating="{{ post.userRating ?? '' }}">
                                        <div class="rating-stars" aria-label="{{ trans('view.forums.topic.view.24') }}">
                                            {% for i in 1..5 %}
                                                {% if user.isGuest %}
                                                    <button type="button"
                                                            class="rating-star"
                                                            data-ui-toggle="modal"
                                                            data-ui-target="#authFormModal"
                                                            aria-label="{{ trans('view.common.rate_aria', {rating: i}) }}">
                                                        <i class="bi bi-star"></i>
                                                    </button>
                                                {% else %}
                                                    <button type="button"
                                                            class="rating-star"
                                                            data-value="{{ i }}"
                                                            aria-label="{{ trans('view.common.rate_aria', {rating: i}) }}">
                                                        <i class="bi {{ post.userRating and i <= post.userRating ? 'bi-star-fill' : 'bi-star' }}"></i>
                                                    </button>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                        <span class="rating-summary forums-post__rating-summary" data-rating-summary>
                                            {% if postFeed.ratingCount > 0 %}
                                                {{ postFeed.ratingAverage|number_format(1) }} {{ trans('view.forums.topic.view.25') }} {{ postFeed.ratingCount }}
                                            {% else %}
                                                {{ trans('view.forums.topic.view.26') }}
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="forums-post__body">
                                <div class="forums-post__head">
                                    <div class="forums-post__when">
                                        {% if post.isOpeningPost %}
                                            <span class="ui-badge">{{ trans('view.forums.topic.view.27') }}</span>
                                        {% endif %}
                                        {% if postFeed.createdAtTitle %}
                                            <time title="{{ postFeed.createdAtTitle }}">{{ postFeed.createdAtLabel }}</time>
                                        {% endif %}
                                    </div>
                                    <a href="#post-{{ postFeed.id }}" class="forums-post__number" title="{{ trans('view.forums.topic.view.28') }}">#{{ post.number }}</a>
                                </div>
                                <div class="content forums-post__content" dir="auto" data-comment-content-wrapper="{{ postFeed.id }}">
                                    {{ postFeed.content|raw }}
                                </div>
                                {% if post.attachments %}
                                    <div class="forums-attachments">
                                        {% for attachment in post.attachments %}
                                            <a href="{{ attachment.url }}" target="_blank" rel="noopener" class="forums-attachment">
                                                <i class="bi {{ attachment.icon }} forums-attachment__icon"></i>
                                                <div class="forums-attachment__text">
                                                    <div class="forums-attachment__name">{{ attachment.name }}</div>
                                                    <div class="forums-attachment__size">{{ attachment.sizeLabel }}</div>
                                                </div>
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {# Author's signature, repeated under every post as forums do.
                                   |raw is safe: users.signature only ever holds purified HTML
                                   (UserService::sanitizeSignature guards both write paths).
                                   .forum-signature is what clamps images - see
                                   custom-content.css. #}
                                {% if post.authorSignature %}
                                    <div class="forum-signature forums-post__signature">
                                        {{ post.authorSignature|raw }}
                                    </div>
                                {% endif %}
                                {% if post.wasEdited %}
                                    <div class="forums-post__edited" title="{{ trans('view.forums.edited_at', {date: post.editedAtTitle}) }}">
                                        <i class="bi bi-pencil"></i>{{ trans('view.forums.topic.view.29') }}
                                    </div>
                                {% endif %}
                                {% if post.canEdit %}
                                    <div class="forums-post__edit" hidden data-comment-edit-wrapper="{{ postFeed.id }}">
                                        <label class="ui-visually-hidden" for="comment-edit-{{ postFeed.id }}">{{ trans('view.forums.topic.view.30') }}</label>
                                        <input id="comment-edit-input-{{ postFeed.id }}" type="hidden" value="{{ post.editableContent|e('html_attr') }}" data-comment-edit-input>
                                        <trix-editor id="comment-edit-{{ postFeed.id }}" input="comment-edit-input-{{ postFeed.id }}"
                                                     class="trix-content" data-comment-edit-editor></trix-editor>
                                        <div class="ui-error" hidden data-comment-edit-error></div>
                                        <div class="forums-post__edit-actions">
                                            <button type="button" class="ui-button ui-button--primary ui-button--sm" data-comment-edit-save data-comment-id="{{ postFeed.id }}" data-parent-id="{{ feed.id }}">{{ trans('view.forums.topic.form.41') }}</button>
                                            <button type="button" class="ui-button ui-button--secondary ui-button--sm" data-comment-edit-cancel data-comment-id="{{ postFeed.id }}">{{ trans('view.comments.cancel') }}</button>
                                        </div>
                                    </div>
                                {% endif %}
                                <div class="forums-post__footer">
                                    <div class="post-actions">
                                        {% if user.isGuest %}
                                            <a href="#authFormModal" data-ui-toggle="modal" data-ui-target="#authFormModal" class="ui-button ui-button--link ui-button--sm"><i class="bi bi-reply"></i>{{ trans('view.comments.reply') }}</a>
                                        {% else %}
                                            <a href="#reply" class="ui-button ui-button--link ui-button--sm"><i class="bi bi-reply"></i>{{ trans('view.comments.reply') }}</a>
                                        {% endif %}
                                        {% if not user.isGuest %}
                                            <button type="button" class="ui-button ui-button--link ui-button--sm"
                                                    data-quote-toggle
                                                    data-quote-author="{{ postFeed.authorDisplayName }}"
                                                    data-quote-content="{{ post.quoteText }}">
                                                <i class="bi bi-quote"></i>{{ trans('view.forums.topic.view.31') }}
                                            </button>
                                        {% else %}
                                            <button type="button" class="ui-button ui-button--link ui-button--sm"
                                                    data-ui-toggle="modal" data-ui-target="#authFormModal">
                                                <i class="bi bi-quote"></i>{{ trans('view.forums.topic.view.31') }}
                                            </button>
                                        {% endif %}
                                        {% if post.canEdit or post.canDelete %}
                                            <span class="post-actions-sep">&middot;</span>
                                        {% endif %}
                                        {% if post.canEdit %}
                                            <button type="button" class="ui-button ui-button--link ui-button--sm"
                                                    data-comment-edit-toggle data-comment-id="{{ postFeed.id }}"
                                                    title="{{ trans('view.forums.topic.view.32') }}">
                                                <i class="bi bi-pencil"></i>{{ trans('view.forums.topic.view.33') }}
                                            </button>
                                        {% endif %}
                                        {% if post.canDelete %}
                                            <button type="button" class="ui-button ui-button--link ui-button--sm forums-danger-link"
                                                    data-comment-delete data-comment-id="{{ postFeed.id }}" data-parent-id="{{ feed.id }}">
                                                <i class="bi bi-trash"></i>{{ trans('view.forums.topic.view.34') }}
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        {% if pagination.total > 1 %}
            {% include 'components/forums/pagination.twig' with {
                pagination: pagination,
                label: trans('view.forums.topic.view.35')
            } only %}
        {% endif %}

        {% if user.isGuest %}
            <div class="ui-alert forums-guest-prompt" id="reply">
                <span>{{ trans('view.forums.topic.view.36') }}</span>
                <button type="button" class="ui-button ui-button--primary ui-button--sm" data-ui-toggle="modal" data-ui-target="#authFormModal">{{ trans('view.auth.sign_in') }}</button>
            </div>
        {% else %}
            <section class="ui-card forums-section" id="reply">
                <div class="forums-section__header">
                    <h2 class="forums-section__heading">{{ trans('view.forums.topic.view.37') }}</h2>
                </div>
                <div class="forums-section__body">
                    <form id="forum-quick-reply-form"
                          data-forum-quick-reply
                          data-parent-id="{{ feed.id }}"
                          data-total-posts="{{ topicTotals.posts }}"
                          data-per-page="{{ pagination.perPage|default(20) }}"
                          data-topic-url="{{ feed.canonicalUrl }}">
                        <label class="ui-visually-hidden" for="forum-quick-reply-content">{{ trans('view.forums.topic.view.38') }}</label>
                        {# Shown instead of the Trix editor by forums.ts's
                           preview toggle. The server still runs the submitted
                           HTML through HTMLPurifier before storing it. #}
                        <div class="content forums-post__content forums-reply__preview" hidden data-forum-quick-reply-preview></div>
                        <input id="forum-quick-reply-content" type="hidden" name="content" value="">
                        <trix-editor id="forum-quick-reply-editor" input="forum-quick-reply-content"
                                     class="trix-content forums-reply__editor"
                                     placeholder="{{ trans('view.forums.topic.view.39') }}"
                                     data-forum-quick-reply-editor></trix-editor>
                        <div class="ui-error" hidden data-forum-quick-reply-error></div>
                        <div class="forums-reply__actions">
                            <button type="submit" class="ui-button ui-button--primary"><i class="bi bi-send"></i><span>{{ trans('view.forums.topic.view.40') }}</span></button>
                            <button type="button" class="ui-button ui-button--secondary ui-button--sm forums-reply__preview-toggle"
                                    data-forum-quick-reply-preview-toggle><i class="bi bi-eye"></i><span>{{ trans('view.forums.topic.form.43') }}</span></button>
                        </div>
                    </form>
                </div>
            </section>
        {% endif %}

        <div class="forums-footer-actions">
            <div>
                {% if parentForum %}
                    <a href="{{ user.isGuest ? '#authFormModal' : topicNewUrl }}" {% if user.isGuest %}data-ui-toggle="modal" data-ui-target="#authFormModal"{% endif %} class="ui-button ui-button--primary">
                        <i class="bi bi-pencil-square"></i>
                        <span>{{ trans('forums.topic_new') }}</span>
                    </a>
                {% endif %}
            </div>
            {% if parentForum %}
                <a href="{{ parentForum.canonicalUrl }}" class="link-quiet">{{ trans('view.forums.topic.view.41', {title: parentForum.title}) }}</a>
            {% endif %}
        </div>

        <section class="ui-card forums-section forums-totals">
            <div class="forums-section__header">
                <h2 class="forums-section__heading">{{ trans('view.forums.topic.view.42') }}</h2>
            </div>
            <div class="forums-totals__body">
                <div class="forums-totals__grid">
                    <div>
                        <div class="forums-totals__value">{{ topicTotals.posts }}</div>
                        <div class="forums-totals__label">{{ trans('view.forums.list.08') }}</div>
                    </div>
                    <div>
                        <div class="forums-totals__value">{{ topicTotals.participants }}</div>
                        <div class="forums-totals__label">{{ trans('view.forums.list.14') }}</div>
                    </div>
                    <div>
                        <div class="forums-totals__value">{{ topicTotals.views }}</div>
                        <div class="forums-totals__label">{{ trans('view.forums.topic.view.43') }}</div>
                    </div>
                </div>
            </div>
        </section>

    </div>
{% endblock %}
