{% extends "layouts/simple.twig" %}

{# Framework-free markup; styles in assets-src/site/modules/forums.css. A
   theme restyles it by overriding this file (see
   views/themes/bootstrap/modules/forums/). Keep the data-* hooks. #}

{% block content %}
    <div class="ui-container forums-page">

        <div class="forums-header">
            <div class="forums-header__text">
                {% if parentForum %}
                    <a href="{{ parentForum.canonicalUrl }}" class="section-eyebrow">{{ trans('view.forums.topic.list.01') }} {{ parentForum.title }}</a>
                {% endif %}
                <h1 class="forums-header__title">{{ title }}</h1>
                {% if description %}
                    <p class="forums-header__desc">{{ description }}</p>
                {% endif %}
            </div>
            <div class="forums-header__aside">
                {% if not subForums %}
                    <a href="{{ user.isGuest ? '#authFormModal' : feed.canonicalUrl ~ 'new/' }}" {% if user.isGuest %}data-ui-toggle="modal" data-ui-target="#authFormModal"{% endif %} class="ui-button ui-button--primary">
                        <i class="bi bi-pencil-square"></i>
                        <span>{{ trans('forums.topic_new') }}</span>
                    </a>
                {% endif %}
                <div class="forums-actions">
                    {# Marks every topic in this section as read for the
                       current user - including its own subforums, if any
                       (see ForumsController::handleMarkAllReadRequest()'s
                       own docblock for why). The site-wide scope is
                       forums.list.twig's own button. #}
                    {% if user.isGuest %}
                        <button type="button" class="ui-button ui-button--secondary ui-button--sm"
                                disabled title="{{ trans('view.forums.list.01') }}">
                            <i class="bi bi-check2-all"></i>
                            <span>{{ trans('view.forums.list.02') }}</span>
                        </button>
                    {% else %}
                        <button type="button" class="ui-button ui-button--secondary ui-button--sm"
                                data-forum-mark-all-read data-forum-id="{{ feed.id }}">
                            <i class="bi bi-check2-all"></i>
                            <span>{{ trans('view.forums.list.02') }}</span>
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="forums-legend">
            <span class="forums-legend__item">
                <i class="bi bi-chat-square-text-fill forums-icon--unread"></i> {{ trans('view.forums.list.03') }}
            </span>
            <span class="forums-legend__item">
                <i class="bi bi-chat-square-text forums-icon--read"></i> {{ trans('view.forums.list.04') }}
            </span>
        </div>

        {% if subForums %}
            <section class="ui-card forums-section">
                <div class="forums-section__header">
                    <button class="forums-section__toggle" type="button"
                            data-ui-toggle="collapse" data-ui-target="#subforums-group" aria-expanded="true" title="{{ trans('view.forums.list.05') }}">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="forums-section__text">
                        <h2 class="forums-section__heading">{{ trans('view.forums.topic.list.02') }}</h2>
                    </div>
                </div>
                <div id="subforums-group">
                    <ul class="forums-rows">
                        {% for subForum in subForums %}
                            {% set stats = subForumStats[subForum.id] %}
                            {% set lastPost = subForumLastPost[subForum.id] %}
                            {% set unreadCount = subForumUnreadCounts[subForum.id] ?? 0 %}
                            <li class="forums-row">
                                <div class="forums-row__main">
                                    {% if unreadCount > 0 %}
                                        <i class="bi bi-chat-square-text-fill forums-row__icon forums-icon--unread" title="{{ trans('view.common.unread_topics', {count: unreadCount}) }}"></i>
                                    {% else %}
                                        <i class="bi bi-chat-square-text forums-row__icon forums-icon--read" title="{{ trans('view.forums.list.06') }}"></i>
                                    {% endif %}
                                    <div class="forums-row__text">
                                        <a href="{{ subForum.canonicalUrl }}" class="forums-row__title">{{ subForum.title }}</a>
                                        {% if unreadCount > 0 %}
                                            <span class="ui-badge forums-count">{{ unreadCount }}</span>
                                        {% endif %}
                                        {% if subForum.description %}
                                            <p class="forums-row__desc">{{ subForum.description }}</p>
                                        {% endif %}
                                        <div class="forums-row__meta forums-row__meta--narrow">
                                            {{ stats.topics|default(0) }} {{ trans('view.forums.list.07') }} {{ stats.posts|default(0) }} {{ trans('view.forums.list.08') }}
                                        </div>
                                    </div>
                                </div>
                                <div class="forums-row__stats">
                                    <div class="forums-stat">
                                        <div class="forums-stat__value">{{ stats.topics|default(0) }}</div>
                                        <div class="forums-stat__label">{{ trans('view.forums.list.09') }}</div>
                                    </div>
                                    <div class="forums-stat forums-stat--wide">
                                        <div class="forums-stat__value">{{ stats.posts|default(0) }}</div>
                                        <div class="forums-stat__label">{{ trans('view.forums.list.08') }}</div>
                                    </div>
                                </div>
                                <div class="forums-row__last">
                                    {% if lastPost %}
                                        <img src="{{ lastPost.authorAvatarUrl }}" alt="{{ lastPost.authorName }}"
                                             class="forums-avatar" width="32" height="32">
                                        <div class="forums-row__text">
                                            <a href="{{ lastPost.topicUrl }}" class="forums-row__last-title"
                                               title="{{ lastPost.topicTitle }}">{{ lastPost.topicTitle }}</a>
                                            <div class="forums-row__last-meta"
                                                 title="{{ lastPost.whenTitle }}"><bdi>{{ lastPost.authorName }}</bdi>, {{ lastPost.when }}</div>
                                        </div>
                                    {% else %}
                                        <span class="forums-row__last-meta">{{ trans('view.forums.list.10') }}</span>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
        {% endif %}

        {% if not subForums %}
            <section class="ui-card forums-section">
                <div class="forums-section__header">
                    <button class="forums-section__toggle" type="button"
                            data-ui-toggle="collapse" data-ui-target="#topics-list" aria-expanded="true" title="{{ trans('view.forums.list.05') }}">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="forums-section__text">
                        <h2 class="forums-section__heading">{{ trans('view.forums.topic.list.03') }}</h2>
                        <div class="forums-section__sub">
                            {{ forumTotals.topics }} {{ trans_choice('forums.topic_unit', forumTotals.topics) }}, {{ forumTotals.posts }} {{ trans_choice('forums.post_unit', forumTotals.posts) }}
                        </div>
                    </div>
                </div>
                <div id="topics-list">
                    {% if topics %}
                        <ul class="forums-rows">
                            {% for row in topics %}
                                {% set topic = row.feed %}
                                <li class="forums-row">
                                    <div class="forums-row__main">
                                        {% if row.unread %}
                                            <i class="bi bi-chat-square-text-fill forums-row__icon forums-icon--unread" title="{{ trans('view.forums.topic.list.04') }}"></i>
                                        {% else %}
                                            <i class="bi bi-chat-square-text forums-row__icon forums-icon--read" title="{{ trans('view.forums.list.06') }}"></i>
                                        {% endif %}
                                        <div class="forums-row__text">
                                            <a href="{{ topic.canonicalUrl }}" class="forums-row__title">{{ topic.title }}</a>
                                            <div class="forums-row__meta">
                                                <i class="bi bi-person"></i> <bdi>{{ topic.authorDisplayName }}</bdi>, {{ topic.createdAtLabel }}
                                            </div>
                                            <div class="forums-row__meta forums-row__meta--narrow">
                                                {{ row.replies }} {{ trans('view.forums.topic.list.05') }}
                                            </div>
                                            <div class="forums-row__meta forums-row__meta--below-lg">
                                                <i class="bi bi-clock-history"></i> <bdi>{{ row.lastAuthorName }}</bdi>, {{ row.lastWhen }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="forums-row__stats">
                                        <div class="forums-stat">
                                            <div class="forums-stat__value">{{ row.replies }}</div>
                                            <div class="forums-stat__label">{{ trans('view.forums.topic.list.05') }}</div>
                                        </div>
                                    </div>
                                    <div class="forums-row__last">
                                        <img src="{{ row.lastAuthorAvatarUrl }}" alt="{{ row.lastAuthorName }}"
                                             class="forums-avatar" width="32" height="32">
                                        <div class="forums-row__text">
                                            <span class="forums-row__last-title" title="{{ row.lastWhenTitle }}"><bdi>{{ row.lastAuthorName }}</bdi></span>
                                            <div class="forums-row__last-meta" title="{{ row.lastWhenTitle }}">{{ row.lastWhen }}</div>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="forums-section__empty">{{ trans('view.forums.topic.list.06') }}</p>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        {% if pagination.total > 1 %}
            {% include 'components/forums/pagination.twig' with {
                pagination: pagination,
                label: trans('view.forums.topic.list.09')
            } only %}
        {% endif %}

        {% if (not subForums) or forumsListUrl %}
            <div class="forums-footer-actions">
                <div>
                    {% if not subForums %}
                        <a href="{{ user.isGuest ? '#authFormModal' : feed.canonicalUrl ~ 'new/' }}" {% if user.isGuest %}data-ui-toggle="modal" data-ui-target="#authFormModal"{% endif %} class="ui-button ui-button--primary">
                            <i class="bi bi-pencil-square"></i>
                            <span>{{ trans('forums.topic_new') }}</span>
                        </a>
                    {% endif %}
                </div>
                {% if forumsListUrl %}
                    <a href="{{ forumsListUrl }}" class="link-quiet">{{ trans('view.forums.topic.list.10') }}</a>
                {% endif %}
            </div>
        {% endif %}

        <section class="ui-card forums-section forums-totals">
            <div class="forums-section__header">
                <h2 class="forums-section__heading">{{ trans('view.forums.topic.list.11') }}</h2>
            </div>
            <div class="forums-totals__body">
                <div class="forums-totals__grid">
                    <div>
                        <div class="forums-totals__value">{{ forumTotals.topics }}</div>
                        <div class="forums-totals__label">{{ trans('view.forums.list.09') }}</div>
                    </div>
                    <div>
                        <div class="forums-totals__value">{{ forumTotals.posts }}</div>
                        <div class="forums-totals__label">{{ trans('view.forums.list.08') }}</div>
                    </div>
                    <div>
                        <div class="forums-totals__value">{{ forumTotals.participants }}</div>
                        <div class="forums-totals__label">{{ trans('view.forums.topic.list.12') }}</div>
                    </div>
                    <div>
                        <div class="forums-totals__value">{{ forumTotals.postsToday }}</div>
                        <div class="forums-totals__label">{{ trans('view.forums.list.15') }}</div>
                    </div>
                </div>
                {# Presence is site-wide, so this deliberately renders the
                   same server-built contract as forums.list rather than
                   pretending these visitors are scoped to this section. #}
                <div class="forums-online">
                    <div class="forums-online__line">
                        <i class="bi bi-broadcast"></i> {{ trans('view.forums.list.16') }}
                        <span class="forums-online__number">{{ onlineNow.total }}</span>
                        {{ onlineNow.totalLabel }},
                        <span class="forums-online__number">{{ onlineNow.guests }}</span>
                        {{ onlineNow.guestLabel }}
                        {%- if onlineNow.bots is not empty %}
                            {{ trans('view.forums.list.17') }} {{ onlineNow.bots|join(', ') }}
                        {%- endif %}
                    </div>
                    {% if onlineNow.members is not empty %}
                        <div class="forums-online__members">
                            {% for member in onlineNow.members %}
                                {%- if member.url -%}
                                    <a href="{{ member.url }}"><bdi>{{ member.displayName }}</bdi></a>
                                {%- else -%}
                                    <span><bdi>{{ member.displayName }}</bdi></span>
                                {%- endif -%}
                                {{- not loop.last ? ', ' : '' -}}
                            {% endfor %}
                            {%- if onlineNow.hidden > 0 %} {{ trans('view.forums.list.18') }} {{ onlineNow.hidden }}{% endif -%}
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

    </div>
{% endblock %}
