{# One template for both forums.topic-new and forums.topic-edit (see
   ForumsController::buildTopicFormViewModel()) - `topic` is null when
   creating and the existing Feed when editing, and every other difference
   below is derived from that rather than from a separate mode flag, the same
   way Modules\Users's blog-post-form.twig serves its own new/edit pair.

   The form's own data-* attributes are the whole contract with forums.ts's
   initTopicForm(): data-api-method picks POST vs PATCH, data-poll /
   data-attachments-existing carry the prefilled state as JSON (poll option
   rows and attachment rows are cloned from the <template>s at the end of
   `content`), and data-poll-locked is the "someone already voted" freeze.

   Framework-free markup; styles in assets-src/site/modules/forums.css. A
   theme restyles it by overriding this file (see
   views/themes/bootstrap/modules/forums/). Keep the ids, data-* hooks and
   the templates' data-slot* fill points. #}
{% extends "layouts/with-sidebar.twig" %}

{% set isEdit = topic is not null %}

{% block main_class %}layout-main forums-page{% endblock %}

{% block content %}
    <div class="forums-header">
        <h1 class="forums-header__title">{{ isEdit ? trans('forums.topic_edit') : trans('forums.topic_new') }}</h1>
        <span class="forums-form__forum"><i class="bi bi-folder2-open"></i> <bdi>{{ feed.title }}</bdi></span>
    </div>

    <div class="ui-alert ui-alert--info forums-form__notice">
        <i class="bi bi-info-circle"></i>
        {% if isEdit %}
            <span>{{ trans('view.forums.topic.form.01') }}</span>
        {% else %}
            <span>{{ trans('view.forums.topic.form.02') }}</span>
        {% endif %}
    </div>

    <form id="topicForm" class="forums-form" data-forum-topic-form data-api-url="{{ apiUrl }}" data-api-method="{{ apiMethod }}"
          data-uploads-api-url="{{ uploadsApiUrl }}" data-forum-id="{{ feed.id }}"
          data-poll-locked="{{ pollLocked ? '1' : '0' }}"
          {# Only when the card is actually editable - a locked poll is rendered
             read-only from `poll` directly below, so shipping it here as well
             would just send the same data twice. #}
          {% if poll and not pollLocked %}data-poll="{{ poll|json_encode|e('html_attr') }}"{% endif %}
          {% if attachments %}data-attachments-existing="{{ attachments|json_encode|e('html_attr') }}"{% endif %}
          data-author-name="{{ user.displayName }}" data-author-avatar="{{ authorAvatarUrl }}">
        <section class="ui-card ui-card__body forums-form__card">
            <label class="ui-label forums-form__label" for="topicTitle">{{ trans('view.forums.topic.form.03') }}</label>
            <input type="text" class="ui-input forums-form__title" id="topicTitle" name="title"
                   maxlength="200" placeholder="{{ trans('view.forums.topic.form.04') }}"
                   value="{{ isEdit ? topic.title : '' }}">
            <div class="ui-error" hidden data-topic-title-error></div>
            <div class="forums-form__hints">
                <span>{{ trans('view.forums.topic.form.05') }}</span>
                <span class="forums-number" id="topicTitleCount">0 / 200</span>
            </div>

            <label class="ui-label forums-form__label" for="topicBodyEditor">{{ trans('view.forums.topic.form.06') }}</label>
            {# Trix initializes its own document from this input's value, so
               prefilling it is the whole "load the existing post into the
               editor" step. The value is the stored, already-purified HTML
               as-is - deliberately *not* run through
               ForumsController::contentToEditableText(), which exists for
               the plain-text quick-reply textarea and would mangle rich
               text (see buildTopicFormViewModel()'s own note). #}
            <input id="topicBody" type="hidden" name="content" value="{{ isEdit ? topic.content : '' }}">
            <trix-editor id="topicBodyEditor" input="topicBody" class="trix-content"
                         placeholder="{{ trans('view.forums.topic.form.07') }}" data-forum-topic-editor></trix-editor>
            <div class="forums-form__hints">
                <span class="ui-error" data-topic-form-error></span>
                <span id="topicWordCount">{{ trans('view.forums.topic.form.08') }}</span>
            </div>
        </section>

        <section class="ui-card forums-section forums-form__card">
            <div class="forums-section__header">
                <button type="button" class="forums-section__toggle"
                        title="{{ trans('view.forums.topic.form.09') }}" data-poll-toggle {{ pollLocked ? 'disabled' : '' }}>
                    <i class="bi bi-chevron-right"></i>
                </button>
                <div class="forums-section__text">
                    <h2 class="forums-section__heading">{{ trans('view.forums.topic.form.10') }}</h2>
                    <div class="forums-section__sub" data-poll-hint>
                        {%- if pollLocked -%}
                            {{ trans('view.forums.topic.form.11') }}
                        {%- else -%}
                            {{ trans('view.forums.topic.form.12') }}
                        {%- endif -%}
                    </div>
                </div>
                {% if not pollLocked %}
                    <button type="button" class="ui-button ui-button--link ui-button--sm" data-poll-toggle>
                        <i class="bi bi-plus-lg"></i><span>{{ trans('view.forums.topic.form.13') }}</span>
                    </button>
                {% else %}
                    <span class="ui-badge"><i class="bi bi-lock"></i> {{ trans('view.forums.topic.form.14') }}</span>
                {% endif %}
            </div>
            {# The locked case renders the poll read-only rather than hiding the
               card, so an author can see *what* they can't change and why -
               forums.ts skips collecting this card entirely when
               data-poll-locked is set, and ForumsController::
               replaceTopicPoll() ignores the field server-side regardless. #}
            {% if pollLocked %}
                <div class="forums-section__body">
                    <div class="forums-poll__question">{{ poll.question }}</div>
                    <ul class="forums-form__locked-options">
                        {% for option in poll.options %}
                            <li>{{ option }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <div class="forums-section__body" hidden data-poll-body>
                    <div class="ui-field">
                        <label class="ui-label forums-form__label" for="pollQuestion">{{ trans('view.forums.topic.form.15') }}</label>
                        <input type="text" class="ui-input" id="pollQuestion" maxlength="200" placeholder="{{ trans('view.forums.topic.form.16') }}">
                    </div>

                    <div class="ui-label forums-form__label">{{ trans('view.forums.topic.form.17') }}</div>
                    <div class="forums-form__options" data-poll-options></div>
                    <div class="forums-form__add-option">
                        <button type="button" class="ui-button ui-button--secondary ui-button--sm" data-poll-add-option>
                            <i class="bi bi-plus-lg"></i><span>{{ trans('view.forums.topic.form.18') }}</span>
                        </button>
                        <span class="forums-number ui-muted" data-poll-option-count></span>
                    </div>

                    <div class="forums-form__poll-settings">
                        <label class="ui-check">
                            <input class="ui-check__input" type="checkbox" role="switch" id="pollMultiple">
                            <span class="ui-check__label">{{ trans('view.forums.topic.form.19') }}</span>
                        </label>
                        <div>
                            <label class="ui-label forums-form__label" for="pollDuration">{{ trans('view.forums.topic.form.20') }}</label>
                            <select class="ui-select" id="pollDuration">
                                <option value="0" selected>{{ trans('view.forums.topic.form.21') }}</option>
                                <option value="7">{{ trans('view.forums.topic.form.22') }}</option>
                                <option value="14">{{ trans('view.forums.topic.form.23') }}</option>
                                <option value="30">{{ trans('view.forums.topic.form.24') }}</option>
                            </select>
                        </div>
                    </div>
                </div>
            {% endif %}
        </section>

        <section class="ui-card ui-card__body forums-form__card">
            <h2 class="ui-card__title"><i class="bi bi-paperclip"></i> {{ trans('view.forums.topic.form.25') }}</h2>
            <div class="forums-dropzone" data-attachments-drop>
                <i class="bi bi-cloud-arrow-up"></i>
                <div>
                    <div>{{ trans('view.forums.topic.form.26') }}</div>
                    <div class="ui-help">{{ trans('view.forums.topic.form.27') }}</div>
                </div>
            </div>
            <input type="file" hidden accept="image/jpeg,image/png,image/webp,application/pdf" multiple data-attachments-input>
            <div class="forums-uploads" data-attachments-list></div>
            <p class="ui-help" hidden data-attachments-empty>{{ trans('view.forums.topic.form.28') }}</p>
        </section>
    </form>

    {# Populated client-side from the form's own current state (forums.ts's
       own initTopicPreview()) - no server round trip, so nothing here is
       real yet (no ownerId/createdAt/etc.) and it isn't a byte-identical
       preview: content is whatever Trix's editor serialized, not the
       HTMLPurifier-cleaned HTML that will actually be stored (see
       ForumsController::handleTopicCreateRequest()'s own purify() call) -
       close enough for "does this look right before I publish", not a
       guarantee. #}
    <dialog class="ui-modal forums-preview-modal" id="topicPreviewModal" aria-labelledby="topicPreviewModalLabel">
        <div class="ui-modal__header">
            <h2 class="ui-modal__title" id="topicPreviewModalLabel"><i class="bi bi-eye"></i> {{ trans('view.forums.topic.form.29') }}</h2>
            <button type="button" class="ui-close" data-ui-dismiss="modal" aria-label="{{ trans('view.forums.topic.form.30') }}">&times;</button>
        </div>
        <div class="ui-modal__body" id="topicPreviewBody"></div>
    </dialog>

    {% block forums_form_templates %}
        {# Hooks: data-poll-option-number, data-poll-option-text (the input),
           data-poll-option-remove. #}
        <template data-ui="forum-poll-option">
            <div class="forums-form__option">
                <span class="forums-form__option-number forums-number" data-poll-option-number>1</span>
                <input type="text" class="ui-input" maxlength="255" placeholder="{{ trans('js.forums.poll_option_placeholder') }}" data-poll-option-text>
                <button type="button" class="ui-button ui-button--secondary" aria-label="{{ trans('js.forums.poll_option_remove') }}" data-poll-option-remove><i class="bi bi-x-lg"></i></button>
            </div>
        </template>

        {# Fill points: iconClass (class), name, status, uploading (optional
           progress, its bar is data-attachment-progress), removeLabel. #}
        <template data-ui="forum-attachment-upload">
            <div class="forums-upload">
                <span class="forums-attachment__icon"><i data-slot-attr="class:iconClass"></i></span>
                <div class="forums-upload__text">
                    <div class="forums-attachment__name"><bdi data-slot="name"></bdi></div>
                    <div class="forums-attachment__size" data-slot="status"></div>
                    <div class="forums-upload__progress" data-slot-optional="uploading">
                        <div class="forums-upload__bar" style="width: 0%" data-attachment-progress></div>
                    </div>
                </div>
                <button type="button" class="ui-button ui-button--link ui-button--sm" data-slot-attr="aria-label:removeLabel" data-attachment-remove>
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </template>

        {# Fill points: avatar, authorName, title, titleEmpty, contentHtml,
           contentEmpty (data-empty marks a placeholder), hasAttachments,
           hasPoll, pollQuestion, pollOptionsEmpty, pollDuration; rows go into
           data-preview-attachments / data-preview-poll-options. #}
        <template data-ui="forum-topic-preview">
            <div class="forums-preview">
                <div class="forums-preview__author">
                    <img class="forums-avatar forums-avatar--lg" width="56" height="56" alt="" data-slot-attr="src:avatar alt:authorName">
                    <div class="forums-post__who">
                        <span class="forums-post__name"><bdi data-slot="authorName"></bdi></span>
                        <span class="ui-badge forums-post__badge forums-post__badge--author">{{ trans('js.forums.topic_author') }}</span>
                    </div>
                </div>
                <div class="forums-preview__main">
                    <h1 class="forums-preview__title" data-slot="title" data-slot-attr="data-empty:titleEmpty"></h1>
                    <div class="content forums-post__content" data-slot-html="contentHtml" data-slot-attr="data-empty:contentEmpty"></div>
                    <div class="forums-attachments" data-slot-optional="hasAttachments" data-preview-attachments></div>
                    <div class="forums-preview__poll" data-slot-optional="hasPoll">
                        <h2 class="forums-poll__question"><i class="bi bi-bar-chart"></i> <span data-slot="pollQuestion"></span></h2>
                        <div class="forums-preview__options" data-preview-poll-options></div>
                        <p class="ui-help" data-slot="pollOptionsEmpty" data-slot-optional="pollOptionsEmpty"></p>
                        <p class="ui-help" data-slot="pollDuration"></p>
                    </div>
                </div>
            </div>
        </template>

        <template data-ui="forum-preview-attachment">
            <div class="forums-attachment">
                <span class="forums-attachment__icon"><i data-slot-attr="class:iconClass"></i></span>
                <span class="forums-attachment__text">
                    <span class="forums-attachment__name"><bdi data-slot="name"></bdi></span>
                    <span class="forums-attachment__size" data-slot="size"></span>
                </span>
            </div>
        </template>

        <template data-ui="forum-preview-poll-option">
            <div class="forums-preview__option" data-slot="text"></div>
        </template>
    {% endblock %}
{% endblock %}

{% block sidebar_widgets %}
    <div class="forums-form__aside">

        <section class="ui-card ui-card__body">
            <h2 class="ui-card__title">
                {%- if isEdit -%}
                    <i class="bi bi-pencil-square"></i> {{ trans('view.forums.topic.form.31') }}
                {%- else -%}
                    <i class="bi bi-send"></i> {{ trans('view.forums.topic.form.32') }}
                {%- endif -%}
            </h2>
            {% if isEdit %}
                <p class="ui-help">
                    <i class="bi bi-clock-history"></i> {{ trans('view.forums.topic.form.33') }}
                </p>
            {% else %}
                <p class="ui-help">
                    <i class="bi bi-people"></i> {{ trans('view.forums.topic.form.34') }} {{ forumTotals.topics }} {{ trans_choice('forums.topic_unit', forumTotals.topics) }} {{ trans('view.forums.topic.form.36') }} {{ forumTotals.posts }} {{ trans_choice('forums.post_unit', forumTotals.posts) }}.
                </p>
            {% endif %}
            <div class="forums-form__submit">
                <button class="ui-button ui-button--primary ui-button--block" type="button" id="btnCreateTopic">
                    <i class="bi {{ isEdit ? 'bi-check2' : 'bi-pencil-square' }}"></i><span id="btnCreateTopicLabel">{{ isEdit ? trans('view.forums.topic.form.41') : trans('view.forums.topic.form.42') }}</span>
                </button>
                <button class="ui-button ui-button--secondary ui-button--sm ui-button--block" type="button" id="btnPreviewTopic">
                    <i class="bi bi-eye"></i> {{ trans('view.forums.topic.form.43') }}
                </button>
                {% if cancelUrl %}
                    <a href="{{ cancelUrl }}" class="ui-button ui-button--link ui-button--block">
                        <i class="bi bi-x-lg"></i> {{ trans('view.comments.cancel') }}
                    </a>
                {% endif %}
            </div>
        </section>

        {# Create-only: by edit time the author already has forums.topic-view's
           own "Follow" toggle, and a save button that silently re-subscribed
           them would be a surprise - the PATCH endpoint ignores `subscribe`
           for the same reason (see handleTopicUpdateRequest()). #}
        {% if not isEdit %}
            <section class="ui-card ui-card__body">
                <h2 class="ui-card__title"><i class="bi bi-bell"></i> {{ trans('view.forums.topic.form.44') }}</h2>
                <label class="ui-check">
                    <input class="ui-check__input" type="checkbox" role="switch" id="topicSubscribe" checked>
                    <span class="ui-check__label">{{ trans('view.forums.topic.form.45') }}</span>
                </label>
                <p class="ui-help">{{ trans('view.forums.topic.form.46') }}</p>
            </section>
        {% endif %}

        <section class="ui-card ui-card__body">
            <h2 class="ui-card__title"><i class="bi bi-info-circle"></i> {{ trans('view.forums.topic.form.47') }}</h2>
            <ul class="forums-form__tips">
                <li>{{ trans('view.forums.topic.form.48') }}</li>
                <li>{{ trans('view.forums.topic.form.49') }}</li>
                <li>{{ trans('view.forums.topic.form.50') }}</li>
            </ul>
        </section>

    </div>
{% endblock %}
