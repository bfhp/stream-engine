{% extends 'components/ui/tab-pane.twig' %}

{# community.manage's "Members" tab - the owner's own moderation queue
   (pending subscribers, "Accept") and member list ("Remove" - a
   demotion back to subscriber, not a hard delete, see CommunityService::
   removeMember()'s own docblock). No "Show more" here yet (see
   UsersController::showCommunityManagePage()'s own docblock) - every row
   FeedService found is already rendered. #}

{% block tab_content %}
    <div
        id="community-manage-members"
        data-community-manage-members
        data-member-action-url-base="{{ memberActionUrlBase }}"
    >
        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title">
                    <i class="bi bi-hourglass-split"></i> {{ trans('view.users.community.manage.members.01') }}
                    {% if subscribersTotal %}<span class="ui-muted">({{ subscribersTotal }})</span>{% endif %}
                </h2>

                <div class="users-people" data-community-manage-subscribers>
                    {% for subscriber in subscribers %}
                        <div class="users-manage-row" data-user-row data-user-id="{{ subscriber.id }}">
                            <a href="{{ subscriber.url ?: '#' }}" class="users-person users-person--grow">
                                <img src="{{ subscriber.avatarUrl }}" alt="" class="users-person__avatar" width="36" height="36">
                                <span class="users-person__name"><bdi>{{ subscriber.displayName }}</bdi></span>
                            </a>
                            <button type="button" class="ui-button ui-button--success ui-button--sm" data-manage-approve>
                                <i class="bi bi-check-lg"></i> {{ trans('view.users.community.manage.members.02') }}
                            </button>
                        </div>
                    {% else %}
                        <p class="users-note">{{ trans('view.users.community.manage.members.03') }}</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title">
                    <i class="bi bi-people"></i> {{ trans('community.manage_members') }}
                    {% if membersTotal %}<span class="ui-muted">({{ membersTotal }})</span>{% endif %}
                </h2>

                <div class="users-people" data-community-manage-members-list>
                    {% for member in members %}
                        <div class="users-manage-row" data-user-row data-user-id="{{ member.id }}">
                            <a href="{{ member.url ?: '#' }}" class="users-person users-person--grow">
                                <img src="{{ member.avatarUrl }}" alt="" class="users-person__avatar" width="36" height="36">
                                <span class="users-person__name"><bdi>{{ member.displayName }}</bdi></span>
                                <span class="ui-badge">{{ member.roleLabel }}</span>
                            </a>
                            {% if member.id != community.ownerId %}
                                <button type="button" class="ui-button ui-button--danger ui-button--sm" data-manage-remove>
                                    <i class="bi bi-x-lg"></i> {{ trans('view.users.community.manage.members.04') }}
                                </button>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="users-note">{{ trans('view.users.community.manage.members.05') }}</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
