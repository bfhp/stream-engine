{% extends 'components/ui/tab-pane.twig' %}

{# community.manage's "Settings" tab - name/description/membership type/
   picture, all saved through a single PATCH (CommunityService::
   updateSettings(), via UsersController::handleCommunityManageSettingsRequest()).
   Same cover-image drop-zone widget/markup as community-create.twig
   (site.css's .blog-post-cover-* classes), just pre-filled with
   the community's existing picture instead of starting empty - see
   initCommunityManageSettingsForm() in users.ts. #}

{% block tab_content %}
    <form
        id="communityManageSettingsForm"
        data-community-manage-settings-form
        data-api-url="{{ settingsApiUrl }}"
        data-uploads-api-url="{{ uploadsApiUrl }}"
        data-membership-type-open="{{ membershipTypeOpen }}"
        data-membership-type-approval="{{ membershipTypeApproval }}"
        data-current-membership-type="{{ membershipType }}"
    >
        <div class="ui-card users-panel">
            <div>
                <label class="ui-label users-caps" for="communityManageName">{{ trans('view.users.community.manage.settings.01') }}</label>
                <input
                    type="text"
                    class="ui-input users-input-lg"
                    id="communityManageName"
                    name="name"
                    value="{{ community.title }}"
                    maxlength="200"
                >

                <label class="ui-label users-caps" for="communityManageDescription">{{ trans('view.users.community.manage.settings.02') }}</label>
                <textarea
                    class="ui-input"
                    id="communityManageDescription"
                    name="description"
                    rows="5"
                    maxlength="2000"
                >{{ community.description }}</textarea>
            </div>
        </div>

        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title"><i class="bi bi-person-check"></i> {{ trans('view.users.community.manage.settings.03') }}</h2>

                <div class="ui-check">
                    <input
                        class="ui-check__input"
                        type="radio"
                        name="membershipType"
                        id="communityManageMembershipTypeOpen"
                        value="{{ membershipTypeOpen }}"
                        {% if membershipType == membershipTypeOpen %}checked{% endif %}
                    >
                    <label class="ui-check__label" for="communityManageMembershipTypeOpen">
                        {{ trans('view.users.community.manage.settings.04') }}
                        <div class="ui-help">{{ trans('view.users.community.manage.settings.05') }}</div>
                    </label>
                </div>

                <div class="ui-check">
                    <input
                        class="ui-check__input"
                        type="radio"
                        name="membershipType"
                        id="communityManageMembershipTypeApproval"
                        value="{{ membershipTypeApproval }}"
                        {% if membershipType == membershipTypeApproval %}checked{% endif %}
                    >
                    <label class="ui-check__label" for="communityManageMembershipTypeApproval">
                        {{ trans('view.users.community.manage.settings.06') }}
                        <div class="ui-help">{{ trans('view.users.community.manage.settings.07') }}</div>
                    </label>
                </div>
            </div>
        </div>

        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title users-panel__title--tight"><i class="bi bi-card-image"></i> {{ trans('view.users.community.manage.settings.08') }}</h2>
                <input type="hidden" id="communityManageCoverImageUrl" data-cover-url value="{{ community.imageUrl }}">
                <div id="communityManageCoverSlot" data-cover-slot>
                    {% if community.imageUrl %}
                        <div class="blog-post-cover-file">
                            <div class="blog-post-cover-thumb" style="background-image:url('{{ community.imageUrl }}')"></div>
                            <div class="blog-post-cover-fileinfo">
                                <div class="blog-post-cover-filename">{{ trans('view.users.community.manage.settings.09') }}</div>
                            </div>
                            <button type="button" class="blog-post-cover-remove" aria-label="{{ trans('view.forums.topic.view.34') }}"><i class="bi bi-x-lg"></i></button>
                        </div>
                    {% else %}
                        <div class="blog-post-cover-drop" data-cover-drop>
                            <i class="bi bi-card-image blog-post-cover-icon"></i>
                            <div>
                                <div>{{ trans('view.users.community.manage.settings.10') }}</div>
                                <div class="ui-help">{{ trans('view.users.community.manage.settings.11') }}</div>
                            </div>
                        </div>
                        <input type="file" hidden accept="image/*" data-cover-file>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="users-actions">
            <button class="ui-button ui-button--primary" type="button" id="btnSaveCommunitySettings">
                <i class="bi bi-check-lg"></i> {{ trans('view.forums.topic.form.41') }}
            </button>
            <span class="users-status" data-community-manage-settings-status></span>
        </div>
    </form>
{% endblock %}
