<form id="registerForm" method="post" action="/api/v1/users" data-success-url="{{ successUrl }}" data-honeypot-field="{{ honeypotField }}" data-registration-mode="{{ registrationMode }}" data-captcha-provider="{{ captchaProvider }}">
    {% block register_hidden %}
    <div class="ui-visually-hidden" aria-hidden="true">
        <input
                name="{{ honeypotField }}"
                type="text"
                class="ui-input"
                id="registerInputHoneypot"
                autocomplete="off"
                tabindex="-1">
    </div>
    {% endblock %}

    {% block register_email %}
    <div class="ui-field">
        <label for="registerInputEmail" class="ui-label">{{ trans('view.users.register.form.02') }}</label>
        <input
                type="email"
                class="ui-input"
                id="registerInputEmail"
                name="email"
                required
                autocomplete="email"
                placeholder="name@example.com"
                aria-describedby="emailHelp">
        <div id="emailHelp" class="ui-help">{{ trans('view.users.register.form.03') }}</div>
    </div>
    {% endblock %}

    {% block register_password %}
    <div class="ui-field">
        <label for="registerInputPassword" class="ui-label">{{ trans('view.auth.password') }}</label>
        <input
                type="password"
                class="ui-input"
                id="registerInputPassword"
                name="password"
                required
                minlength="10"
                autocomplete="new-password"
                aria-describedby="passwordHelp">
        <div id="passwordHelp" class="ui-help">{{ trans('view.users.register.form.04') }}</div>
    </div>
    {% endblock %}

    {% block register_captcha %}
    {% if captchaProvider != 'none' %}
    <div class="ui-field">
        <label class="ui-label">{{ trans('view.users.register.form.05') }}</label>
        {% if captchaProvider == 'turnstile' %}
            <div class="cf-turnstile" data-sitekey="{{ captchaSiteKey }}" data-action="registration"></div>
        {% elseif captchaProvider == 'hcaptcha' %}
            <div class="h-captcha" data-sitekey="{{ captchaSiteKey }}"></div>
        {% endif %}
    </div>
    {% endif %}
    {% endblock %}

    {% block register_submit %}
    <button type="submit" class="ui-button ui-button--primary">{{ trans('view.auth.register') }}</button>
    {% endblock %}
</form>
