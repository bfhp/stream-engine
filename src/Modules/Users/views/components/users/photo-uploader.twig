        <section id="album-upload" class="users-photo-uploader" data-photo-uploader data-album-url="{{ albumUrl }}" data-api-url="{{ photoUploadApiUrl }}">
            <div class="users-photo-dropzone" data-photo-dropzone>
                <i class="bi bi-images" aria-hidden="true"></i>
                <input data-photo-files type="file" name="files[]" accept="image/jpeg,image/png,image/webp" multiple aria-label="{{ trans('photos.select_many') }}" hidden>
                <p>{{ trans('photos.batch_hint') }}</p>
            </div>
            <div class="users-actions users-photo-queue__controls" data-photo-queue-controls hidden>
                <span data-photo-summary role="status" aria-live="polite" aria-atomic="true"></span>
                <button type="button" class="ui-button ui-button--secondary ui-button--sm" data-photo-pause hidden>{{ trans('js.photos.batch_pause') }}</button>
                <button type="button" class="ui-button ui-button--secondary ui-button--sm" data-photo-retry-all hidden>{{ trans('photos.retry_failed') }}</button>
            </div>
        </section>
