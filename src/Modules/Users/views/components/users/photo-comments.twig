<div data-photo-comment-thread data-parent-id="{{ photoComments.rootId }}" data-thread-parent="{{ photoComments.parentId }}">
    <div data-photo-comment-list>
        {% for item in photoComments.items %}{% include 'components/users/photo-comment.twig' with {isReply: photoComments.isReplyPage} %}{% else %}<p class="ui-help" data-photo-comment-empty>{{ trans('photos.comments_empty') }}</p>{% endfor %}
    </div>
    {% if photoComments.cursor %}<button type="button" class="ui-button ui-button--secondary ui-button--sm" data-photo-comments-more data-cursor="{{ photoComments.cursor }}" data-parent="{{ photoComments.parentId }}">{{ trans('view.comments.load_more', {count: 5}) }}</button>{% endif %}
    <p data-photo-comment-error role="alert"></p>
    {% if not photoCommentGuest and not photoComments.isReplyPage %}
        <form class="users-photo-composer" data-photo-comment-form>
            <button type="button" class="users-photo-composer__prompt" data-photo-compose-open hidden>{{ trans('view.comments.placeholder') }}…</button>
            <p class="ui-help" data-photo-comment-context hidden></p>
            <label class="ui-visually-hidden" for="photo-comment-text">{{ trans('view.comments.comment') }}</label>
            <textarea class="ui-input" id="photo-comment-text" name="content" rows="3" maxlength="5000" required placeholder="{{ trans('view.comments.placeholder') }}"></textarea>
            <div class="users-actions" data-photo-compose-actions><button type="submit" class="ui-button ui-button--primary ui-button--sm">{{ trans('view.comments.submit') }}</button><button type="button" class="ui-button ui-button--secondary ui-button--sm" data-photo-comment-cancel>{{ trans('photos.manage.cancel') }}</button></div>
        </form>
    {% elseif photoCommentGuest and not photoComments.isReplyPage %}
        <a data-photo-login href="{{ photo.canonicalUrl }}?login=1">{{ trans('view.comments.sign_in_hint') }}</a>
    {% endif %}
</div>
