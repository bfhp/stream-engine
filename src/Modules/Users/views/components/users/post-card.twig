{#
    Blog-post feed card, shared by the profile feed (modules/users/show.twig)
    and the community feeds (community.twig, community-show.twig).

    Rendered once per post, and once more inside <template data-ui="post-card">
    (asTemplate: true) for the cards assets-src/pages/user-cards.ts appends from
    the API. In template mode every optional piece is rendered so the script
    can fill or drop it; a theme overriding this file keeps the fill points:
      image | noImage, authorAvatar, authorName, authorUrl | authorText,
      date, readTime, dateAndRead, hasMeta, title, url, excerpt,
      hasTags (+ data-post-tags, filled with post-tag.twig copies),
      comments, rating | noRating, audioTrackId.

    Expects: post (card array), showAuthor (bool, default false), asTemplate
    (bool, default false).
#}
{% set showAuthor = showAuthor|default(false) %}
{% set asTemplate = asTemplate|default(false) %}

<article class="ui-card post-card">
    <div class="post-card__layout">
        <div class="post-card__media">
            {% if post.imageUrl or asTemplate %}
                <img src="{{ post.imageUrl }}" alt="" class="post-card__image" data-slot-attr="src:image" data-slot-optional="image">
            {% endif %}
            {% if not post.imageUrl or asTemplate %}
                <div class="post-card__placeholder" data-slot-optional="noImage">
                    <i class="bi bi-image"></i>
                </div>
            {% endif %}
        </div>
        <div class="post-card__main">
            <div class="ui-card__body">
                {% if showAuthor %}
                    <div class="post-card__meta">
                        <img src="{{ post.authorAvatarUrl }}" alt="" class="post-card__avatar" width="24" height="24" data-slot-attr="src:authorAvatar">
                        {% if post.authorUrl or asTemplate %}
                            <a href="{{ post.authorUrl }}" class="post-card__author" data-slot-attr="href:authorUrl" data-slot-optional="authorUrl"><bdi data-slot="authorName">{{ post.authorName }}</bdi></a>
                        {% endif %}
                        {% if not post.authorUrl or asTemplate %}
                            <span class="post-card__author" data-slot-optional="authorText"><bdi data-slot="authorName">{{ post.authorName }}</bdi></span>
                        {% endif %}
                        {% if post.dateLabel or asTemplate %}<span data-slot-optional="date">&middot;</span><span data-slot="date" data-slot-optional="date">{{ post.dateLabel }}</span>{% endif %}
                        {% if post.readTimeLabel or asTemplate %}<span data-slot-optional="readTime">&middot;</span><span data-slot="readTime" data-slot-optional="readTime">{{ post.readTimeLabel }}</span>{% endif %}
                    </div>
                {% elseif post.dateLabel or post.readTimeLabel or asTemplate %}
                    <div class="post-card__meta" data-slot-optional="hasMeta">
                        {% if post.dateLabel or asTemplate %}
                            <i class="bi bi-calendar3" data-slot-optional="date"></i><span data-slot="date" data-slot-optional="date">{{ post.dateLabel }}</span>
                        {% endif %}
                        {% if (post.dateLabel and post.readTimeLabel) or asTemplate %}<span data-slot-optional="dateAndRead">&middot;</span>{% endif %}
                        {% if post.readTimeLabel or asTemplate %}<span data-slot="readTime" data-slot-optional="readTime">{{ post.readTimeLabel }}</span>{% endif %}
                    </div>
                {% endif %}

                <h3 class="post-card__title">
                    <a href="{{ post.url ?: '#' }}" class="post-card__link" data-slot="title" data-slot-attr="href:url">{{ post.title }}</a>
                </h3>

                {% if post.excerpt or asTemplate %}
                    <p class="post-card__excerpt" data-slot="excerpt" data-slot-optional="excerpt">{{ post.excerpt }}</p>
                {% endif %}

                {% if post.tags or asTemplate %}
                    <div class="post-card__tags" data-post-tags data-slot-optional="hasTags">
                        {% for tag in post.tags|default([]) %}
                            {% include 'components/users/post-tag.twig' with {tag: tag} only %}
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="post-card__stats">
                    <span><i class="bi bi-chat-left-text"></i><span data-slot="comments">{{ post.commentCount }}</span></span>
                    {% if post.ratingCount > 0 or asTemplate %}
                        <span data-slot-optional="rating"><i class="bi bi-star-fill post-card__star"></i><span data-slot="rating">{{ post.ratingAverage|number_format(1) }}</span></span>
                    {% endif %}
                    {% if not (post.ratingCount > 0) or asTemplate %}
                        <span data-slot-optional="noRating"><i class="bi bi-star"></i>{{ trans('view.users.post.card.01') }}</span>
                    {% endif %}
                    {% if post.audioTrackId or asTemplate %}
                        <button type="button" class="ui-button ui-button--secondary ui-button--sm post-card__play" data-audio-play-track-id="{{ post.audioTrackId }}"
                                data-slot-optional="audioTrackId" data-slot-attr="data-audio-play-track-id:audioTrackId">
                            <i class="bi bi-play-fill"></i> {{ trans('view.users.post.card.02') }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</article>
