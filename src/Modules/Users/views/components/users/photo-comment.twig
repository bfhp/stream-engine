<article class="users-photo-comment" data-photo-comment data-id="{{ item.feed.id }}" data-author="{{ item.feed.authorDisplayName }}" data-comment-parent="{{ item.feed.parentId }}">
    <div class="users-photo-comment__byline">{% if item.feed.authorAvatarUrl %}<img src="{{ item.feed.authorAvatarUrl }}" width="28" height="28" alt="">{% endif %}<bdi>{{ item.feed.authorDisplayName }}</bdi>{% if item.feed.createdAtLabel %}<small>{{ item.feed.createdAtLabel }}</small>{% endif %}</div>
    <div class="content" data-photo-comment-body>{{ item.feed.content|raw }}</div>
    <div class="users-actions">
        {% if not photoCommentGuest and not isReply %}<button type="button" class="ui-button ui-button--link ui-button--sm" data-photo-comment-reply>{{ trans('view.comments.reply') }}</button>{% endif %}
        {% if item.canEdit or item.canDelete %}
            <details class="users-photo-comment__menu" data-photo-comment-menu>
                <summary aria-label="{{ trans('photos.comment_actions') }}">⋯</summary>
                <div>
                    {% if item.canEdit %}<button type="button" data-photo-comment-edit>{{ trans('photos.comment_edit') }}</button>{% endif %}
                    {% if item.canDelete %}<button type="button" data-photo-comment-delete>{{ trans('photos.comment_delete') }}</button>{% endif %}
                </div>
            </details>
        {% endif %}
    </div>
    {% if not isReply %}<div class="users-photo-comment__replies" data-photo-comment-replies>
        {% for reply in item.replies %}{% include 'components/users/photo-comment.twig' with {item: reply, isReply: true} %}{% endfor %}
        {% if item.nextReplies %}<button type="button" class="ui-button ui-button--link" data-photo-comments-more data-parent="{{ item.feed.id }}" data-cursor="{{ item.nextReplies }}">{{ trans('view.comments.load_more', {count: 3}) }}</button>{% endif %}
    </div>{% endif %}
</article>
