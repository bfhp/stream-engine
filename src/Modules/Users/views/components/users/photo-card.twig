<figure class="ui-card users-panel users-album-photo" {% if isManage %}data-photo-card data-slug="{{ item.slug }}" data-title="{{ item.title }}" data-caption="{{ item.caption }}"{% endif %}>
    {% if isManage %}
        <label class="users-album-photo__select"><input type="checkbox" data-photo-select aria-label="{{ trans('photos.manage.select_photo') }} {{ item.title }}"></label>
        <span class="ui-badge users-album-photo__cover" data-photo-cover-badge {% if not item.cover %}hidden{% endif %}>{{ trans('photos.manage.cover') }}</span>
        <span class="users-album-photo__grip" data-photo-grip aria-hidden="true">⠿</span>
    {% endif %}
    <a data-photo-link href="{{ item.url }}"><img{% if isManage %} draggable="false"{% endif %} src="{{ item.previewUrl }}" alt="{{ item.title }}" loading="lazy" decoding="async"></a>
    <figcaption><a data-photo-name href="{{ item.url }}">{{ item.title }}</a></figcaption>
    {% if isManage %}
        <div class="users-album-photo__menu">
            <button type="button" class="ui-button users-album-photo__menu-toggle" data-photo-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-label="{{ trans('photos.manage.photo_menu') }}">⋯</button>
            <div class="users-album-photo__popover" data-photo-menu role="menu" aria-label="{{ trans('photos.manage.photo_menu') }}" hidden>
                <button type="button" role="menuitem" tabindex="-1" data-photo-edit>{{ trans('photos.manage.details') }}</button>
                <button type="button" role="menuitem" tabindex="-1" data-photo-set-cover{% if item.cover %} disabled{% endif %}>{{ item.cover ? trans('photos.manage.album_cover') : trans('photos.manage.set_cover') }}</button>
                <button type="button" role="menuitem" tabindex="-1" class="users-album-photo__delete" data-photo-delete>{{ trans('photos.manage.delete_photo') }}</button>
            </div>
        </div>
    {% endif %}
</figure>
