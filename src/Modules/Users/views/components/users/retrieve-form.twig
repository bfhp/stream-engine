<form id="forgotPasswordForm"
      method="post"
      action="/api/v1/retrieve">

    {% set fieldId = 'retrieveEmail' %}

    <div class="ui-field users-field">
        <label for="{{ fieldId }}" class="ui-label">
            {{ trans('view.users.register.form.02') }}
        </label>

        <input
                class="ui-input"
                type="email"
                id="{{ fieldId }}"
                name="email"
                required
                placeholder="name@example.com"
                autocomplete="email"
        >
    </div>

    {% block retrieve_submit %}
        <button type="submit" class="ui-button ui-button--primary">
            {{ trans('view.users.retrieve.form.01') }}
        </button>
    {% endblock %}
</form>
