{% if audioPlaylist is defined and audioPlaylist %}
    {% set firstTrack = audioPlaylist|first %}
    <div class="ui-card users-panel audio-player-card" role="region" aria-label="{{ trans('js.audio.player') }}" data-audio-player data-playlist="{{ audioPlaylist|json_encode|e('html_attr') }}">
        <div>
            <div class="audio-player-controls">
                <button type="button" class="ui-button ui-button--secondary ui-button--sm audio-player-btn" data-audio-prev title="{{ trans('view.users.audio.player.01') }}" aria-label="{{ trans('view.users.audio.player.01') }}">
                    <i class="bi bi-skip-backward-fill" aria-hidden="true"></i>
                </button>
                <button type="button" class="ui-button ui-button--primary ui-button--sm audio-player-btn" data-audio-toggle title="{{ trans('view.users.audio.player.02') }}" aria-label="{{ trans('view.users.audio.player.02') }}">
                    <i class="bi bi-play-fill" data-audio-toggle-icon aria-hidden="true"></i>
                </button>
                <button type="button" class="ui-button ui-button--secondary ui-button--sm audio-player-btn" data-audio-next title="{{ trans('view.users.audio.player.03') }}" aria-label="{{ trans('view.users.audio.player.03') }}">
                    <i class="bi bi-skip-forward-fill" aria-hidden="true"></i>
                </button>

                <div class="audio-player-info">
                    <div class="audio-player-title"><span class="ui-visually-hidden">{{ trans('js.audio.current_track') }} </span><bdi data-audio-title>{{ firstTrack.title }}</bdi></div>
                    {% if firstTrack.postUrl %}
                        <a href="{{ firstTrack.postUrl }}" class="audio-player-post" data-audio-post>{{ firstTrack.postTitle ?: trans('view.users.audio.player.04') }}</a>
                    {% else %}
                        <span class="audio-player-post" data-audio-post>{{ firstTrack.postTitle ?: trans('view.users.audio.player.04') }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="audio-player-progress">
                <span class="audio-player-time" data-audio-current aria-hidden="true">0:00</span>
                <input type="range" class="audio-player-range" min="0" max="1000" value="0" step="1" data-audio-seek aria-label="{{ trans('view.users.audio.player.05') }}">
                <span class="audio-player-time audio-player-time--end" data-audio-duration aria-hidden="true">0:00</span>
            </div>

            <ul class="audio-player-list" role="list" aria-label="{{ trans('js.audio.playlist') }}" data-audio-list>
                {% for track in audioPlaylist %}
                    <li>
                        <button
                            type="button"
                            class="audio-player-track{% if loop.first %} is-active{% endif %}"
                            {% if loop.first %}aria-current="true"{% endif %}
                            data-audio-track-index="{{ loop.index0 }}"
                            title="{{ track.title }}"
                        >
                            <span class="audio-player-track__title"><bdi>{{ track.title }}</bdi></span>
                        </button>
                    </li>
                {% endfor %}
            </ul>

            <audio preload="metadata" data-audio-element></audio>
        </div>
    </div>
{% endif %}
