{% if audioPlaylist is defined and audioPlaylist %}
    {% set firstTrack = audioPlaylist|first %}
    <div class="card mb-3 audio-player-card" data-audio-player data-playlist="{{ audioPlaylist|json_encode|e('html_attr') }}">
        <div class="card-body p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <button type="button" class="btn btn-sm btn-outline-secondary audio-player-btn" data-audio-prev title="{{ trans('view.users.audio.player.01') }}" aria-label="{{ trans('view.users.audio.player.01') }}">
                    <i class="bi bi-skip-backward-fill"></i>
                </button>
                <button type="button" class="btn btn-sm btn-primary audio-player-btn" data-audio-toggle title="{{ trans('view.users.audio.player.02') }}" aria-label="{{ trans('view.users.audio.player.02') }}">
                    <i class="bi bi-play-fill" data-audio-toggle-icon></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary audio-player-btn" data-audio-next title="{{ trans('view.users.audio.player.03') }}" aria-label="{{ trans('view.users.audio.player.03') }}">
                    <i class="bi bi-skip-forward-fill"></i>
                </button>

                <div class="min-w-0 flex-grow-1">
                    <div class="small fw-semibold text-truncate" data-audio-title>{{ firstTrack.title }}</div>
                    {% if firstTrack.postUrl %}
                        <a href="{{ firstTrack.postUrl }}" class="small text-body-secondary text-truncate d-block text-decoration-none" data-audio-post>{{ firstTrack.postTitle ?: trans('view.users.audio.player.04') }}</a>
                    {% else %}
                        <span class="small text-body-secondary text-truncate d-block" data-audio-post>{{ firstTrack.postTitle ?: trans('view.users.audio.player.04') }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 small text-body-secondary">
                <span class="audio-player-time" data-audio-current>0:00</span>
                <input type="range" class="form-range audio-player-range" min="0" max="1000" value="0" step="1" data-audio-seek aria-label="{{ trans('view.users.audio.player.05') }}">
                <span class="audio-player-time text-end" data-audio-duration>0:00</span>
            </div>

            <div class="audio-player-list mt-2" data-audio-list>
                {% for track in audioPlaylist %}
                    <button
                        type="button"
                        class="audio-player-track{% if loop.first %} is-active{% endif %}"
                        data-audio-track-index="{{ loop.index0 }}"
                        title="{{ track.title }}"
                    >
                        <span class="text-truncate">{{ track.title }}</span>
                    </button>
                {% endfor %}
            </div>

            <audio preload="metadata" data-audio-element></audio>
        </div>
    </div>
{% endif %}
