{% extends "layouts/with-sidebar.twig" %}

{% block content %}

    {% block blog_post_header %}
        <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
            <div class="d-flex align-items-center gap-2">
                <img
                    src="{{ authorAvatarUrl }}"
                    alt="{{ feed.authorDisplayName }}"
                    class="rounded-circle object-fit-cover"
                    width="40"
                    height="40"
                >
                <div>
                    <div class="fw-semibold">
                        {% if authorUrl %}
                            <a href="{{ authorUrl }}">{{ feed.authorDisplayName }}</a>
                        {% else %}
                            {{ feed.authorDisplayName }}
                        {% endif %}
                    </div>
                    {% if feed.createdAtLabel %}
                        <div class="small text-body-secondary">{{ feed.createdAtLabel }}</div>
                    {% endif %}
                </div>
            </div>

            {# editUrl/canDelete are already gated server-side by whoever
               set them (UsersController::showBlogPostPage() keeps editUrl
               author-only; showCommunityPostPage() gives both the same
               $canDelete policy - owner, admin, or a community's
               moderators - via FeedService::canEditFeed(), mirroring the
               actual PATCH/DELETE server-side check exactly), so this
               template never shows a button that the request would then
               reject - it just checks whether each URL/flag is present. #}
            {% if currentPostAudioTrackId or canDelete or editUrl %}
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    {% if currentPostAudioTrackId %}
                        <button type="button" class="btn btn-sm btn-outline-primary" data-audio-play-track-id="{{ currentPostAudioTrackId }}">
                            <i class="bi bi-play-fill"></i> {{ trans('view.users.post.card.02') }}
                        </button>
                    {% endif %}
                    {% if editUrl %}
                        <a href="{{ editUrl }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i> {{ trans('view.forums.topic.view.06') }}
                        </a>
                    {% endif %}
                    {% if canDelete %}
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-danger"
                            data-blog-post-delete
                            data-feed-id="{{ feed.id }}"
                            data-redirect-url="{{ deleteRedirectUrl }}"
                        >
                            <i class="bi bi-trash"></i> {{ trans('view.forums.topic.view.34') }}
                        </button>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <h1 class="h2 mb-3">{{ feed.title }}</h1>
    {% endblock %}

    {% block blog_post_image %}
        {% if feed.imageUrl %}
            <img src="{{ feed.imageUrl }}" alt="{{ feed.title }}" class="img-fluid rounded mb-3 w-100" style="height: 320px; object-fit: cover;">
        {% endif %}
    {% endblock %}

    {% block blog_post_content %}
        <div class="trix-content">
            {{ feed.content|raw }}
        </div>
    {% endblock %}

    {# Rating + share sit together as a distinct "engagement" strip - a
       border-top and its own padding keep them from reading as more
       paragraphs of blog_post_content right above. #}
    {% block blog_post_engagement %}
        <div class="d-flex flex-column align-items-center gap-3 text-center border-top pt-4 mt-4">

            {% block blog_post_rating %}
                {# Generic feed rating widget (the shared implementation) - data-rate-feed/data-feed-id/data-user-rating
                   are picked up by CMS.initRating(), already called
                   globally in main.ts, so there's nothing extra to wire up
                   here. #}
                <div class="blog-post-rating d-flex align-items-center justify-content-center flex-wrap gap-2"
                     data-rate-feed
                     data-feed-id="{{ feed.id }}"
                     data-user-rating="{{ userRating ?? '' }}">
                    <div class="rating-stars d-inline-flex" aria-label="{{ trans('view.users.blog.post.show.01') }}">
                        {% for i in 1..5 %}
                            {% if user.isGuest %}
                                <button type="button"
                                        class="rating-star btn btn-link p-0 border-0"
                                        data-bs-toggle="modal"
                                        data-bs-target="#authFormModal"
                                        aria-label="{{ trans('view.common.rate_aria', {rating: i}) }}">
                                    <i class="bi bi-star"></i>
                                </button>
                            {% else %}
                                <button type="button"
                                        class="rating-star btn btn-link p-0 border-0"
                                        data-value="{{ i }}"
                                        aria-label="{{ trans('view.common.rate_aria', {rating: i}) }}">
                                    <i class="bi {{ userRating and i <= userRating ? 'bi-star-fill' : 'bi-star' }}"></i>
                                </button>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <span class="rating-summary text-body-secondary small" data-rating-summary>
                        {% if feed.ratingCount > 0 %}
                            {{ feed.ratingAverage|number_format(1) }} {{ trans('view.users.blog.post.show.02') }} {{ feed.ratingCount }}
                        {% else %}
                            {{ trans('view.forums.topic.view.26') }}
                        {% endif %}
                    </span>
                </div>
            {% endblock %}

            {% block blog_post_share %}
                {% include 'partials/share-buttons.twig' %}
            {% endblock %}

        </div>
    {% endblock %}

    {% block blog_post_comments %}
        {% if comments %}
            {% include 'partials/comments.twig' %}
        {% endif %}
    {% endblock %}

{% endblock %}

{% block sidebar_widgets %}
    {# A post inside a community (community.post-show) shows that
       community's own sidebar - the same one community.show itself
       renders - rather than the author's personal profile-sidebar.twig; a
       personal blog post (user.post-show) keeps the profile sidebar. See
       UsersController::showCommunityPostPage()/showBlogPostPage() for
       where isCommunityPost and the community* variables below come from. #}
    {% if isCommunityPost %}
        {% include 'components/users/community-sidebar.twig' with {
            isGuest: user.isGuest,
            community: community,
            imageUrl: communityImageUrl,
            owner: communityOwner,
            ownerUrl: communityOwnerUrl,
            relationshipStatus: communityRelationshipStatus,
            membershipActionUrl: communityMembershipActionUrl,
            manageUrl: communityManageUrl,
            members: communityMembers,
            hasMembers: hasCommunityMembers,
            membersTotal: communityMembersTotal,
            membersApiUrl: communityMembersApiUrl,
            membersNextOffset: communityMembersNextOffset,
            ratingCount: communityRatingCount,
            ratingAverage: communityRatingAverage,
            ratingFullStars: communityRatingFullStars,
            ratingHasHalfStar: communityRatingHasHalfStar,
            ratingHint: communityRatingHint,
            postCount: communityPostCount,
            commentCount: communityCommentCount,
            createdAtLabel: communityCreatedAtLabel,
        } only %}
    {% else %}
        {% include 'components/users/profile-sidebar.twig' %}
    {% endif %}

    {% include 'components/users/audio-player.twig' with {audioPlaylist: audioPlaylist} only %}
{% endblock %}
