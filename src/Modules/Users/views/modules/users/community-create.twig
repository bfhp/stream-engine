{% extends "layouts/with-sidebar.twig" %}

{% block main_class %}layout-main users-page{% endblock %}

{% block content %}
    <div class="users-heading">
        <h1 class="users-heading__title">{{ trans('view.users.community.create.01') }}</h1>
    </div>

    <form
        id="communityCreateForm"
        data-community-create-form
        data-api-url="{{ apiUrl }}"
        data-uploads-api-url="{{ uploadsApiUrl }}"
    >
        <div class="ui-card users-panel">
            <div>
                <label class="ui-label users-caps" for="communityName">{{ trans('view.users.community.manage.settings.01') }}</label>
                <input
                    type="text"
                    class="ui-input users-input-lg"
                    id="communityName"
                    name="name"
                    placeholder="{{ trans('view.users.community.create.02') }}"
                    maxlength="200"
                >

                <label class="ui-label users-caps" for="communityDescription">{{ trans('view.users.community.manage.settings.02') }}</label>
                <textarea
                    class="ui-input"
                    id="communityDescription"
                    name="description"
                    rows="5"
                    maxlength="2000"
                    placeholder="{{ trans('view.users.community.create.03') }}"
                ></textarea>

                <div class="users-form-error">
                    <span id="communityCreateFormError" data-community-create-error></span>
                </div>
            </div>
        </div>
    </form>
{% endblock %}

{% block sidebar_widgets %}
    <div class="blog-post-sidebar-sticky" data-community-create-form-owner>

        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title"><i class="bi bi-person-check"></i> {{ trans('view.users.community.manage.settings.03') }}</h2>

                <div class="ui-check">
                    <input
                        class="ui-check__input"
                        type="radio"
                        name="membershipType"
                        id="membershipTypeOpen"
                        value="{{ membershipTypeOpen }}"
                        checked
                    >
                    <label class="ui-check__label" for="membershipTypeOpen">
                        {{ trans('view.users.community.manage.settings.04') }}
                        <div class="ui-help">{{ trans('view.users.community.manage.settings.05') }}</div>
                    </label>
                </div>

                <div class="ui-check users-gap">
                    <input
                        class="ui-check__input"
                        type="radio"
                        name="membershipType"
                        id="membershipTypeApproval"
                        value="{{ membershipTypeApproval }}"
                    >
                    <label class="ui-check__label" for="membershipTypeApproval">
                        {{ trans('view.users.community.manage.settings.06') }}
                        <div class="ui-help">{{ trans('view.users.community.manage.settings.07') }}</div>
                    </label>
                </div>

                <div class="users-stack">
                    <button class="ui-button ui-button--primary" type="button" id="btnCreateCommunity" form="communityCreateForm">
                        <i class="bi bi-people"></i> {{ trans('view.users.community.create.04') }}
                    </button>
                    {% if cancelUrl %}
                        <a href="{{ cancelUrl }}" class="ui-button ui-button--link users-cancel">
                            <i class="bi bi-x-lg"></i> {{ trans('view.comments.cancel') }}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title users-panel__title--tight"><i class="bi bi-card-image"></i> {{ trans('view.users.community.manage.settings.08') }}</h2>
                <input type="hidden" id="coverImageUrl" data-cover-url value="">
                <div id="coverSlot" data-cover-slot>
                    <div class="blog-post-cover-drop" data-cover-drop>
                        <i class="bi bi-card-image blog-post-cover-icon"></i>
                        <div>
                            <div>{{ trans('view.users.community.manage.settings.10') }}</div>
                            <div class="ui-help">{{ trans('view.users.community.manage.settings.11') }}</div>
                        </div>
                    </div>
                    <input type="file" hidden accept="image/*" data-cover-file>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
