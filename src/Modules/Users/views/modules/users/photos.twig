{% extends isAlbumForm ? "layouts/with-sidebar.twig" : "layouts/single.twig" %}
{% block main_class %}layout-main users-album-page{% endblock %}
{% block layout_container_class %}ui-container{% endblock %}
{% block content %}
    {% if not isAlbumForm and not isManage %}
    <div class="users-album-context">
        {% if photoOwner.url %}<a class="users-album-owner" href="{{ photoOwner.url }}">
            {% if photoOwner.avatar %}<img src="{{ photoOwner.avatar }}" alt="" width="32" height="32">{% endif %}
            <bdi>{{ photoOwner.name }}</bdi>
        </a>{% endif %}
        {% if album %}<a href="{{ listUrl }}">{{ trans('photos.back_to_albums') }}</a>{% endif %}
    </div>
    {% endif %}
    {% block photos_back_link %}
        {% if photo %}<a class="users-back-link" href="{{ albumUrl }}">← {{ album.title }}</a>{% endif %}
    {% endblock %}
    <section{% if isManage %} data-album-manager data-api-url="{{ itemApiUrl }}" data-photos-api-url="{{ photoUploadApiUrl }}"{% endif %}>
        <div class="users-heading">
            <h1 data-album-heading>{{ isManage ? album.title : title }}</h1>
            <div class="users-actions">
                {% if isManage %}
                    <button type="button" class="ui-button ui-button--secondary" data-album-settings-open>{{ trans('photos.manage.settings') }}</button>
                    <a class="ui-button ui-button--secondary" href="{{ albumUrl }}">{{ trans('photos.manage.view') }}</a>
                {% elseif album and canEditAlbum %}
                    <a class="ui-button ui-button--secondary" href="{{ editAlbumUrl }}">{{ trans('photos.manage.open') }}</a>
                {% elseif canCreate and not isAlbumForm %}
                    <a class="ui-button ui-button--primary" href="{{ newAlbumUrl }}">{{ trans('photos.new_album') }}</a>
                {% endif %}
            </div>
        </div>
        {% if isManage %}
            <p class="users-album-description" data-album-description{% if not album.description %} hidden{% endif %}>{{ album.description|striptags }}</p>
            {% include 'components/users/photo-album-settings.twig' %}
            <section class="users-album-workspace" aria-labelledby="album-photos-heading">
                <div class="users-heading">
                    <h2 id="album-photos-heading" class="users-heading__title--sm">{{ trans('photos.title') }} · <span data-album-photo-count>{{ photoItems|length }}</span></h2>
                    {% if newPhotoUrl %}<button type="button" class="ui-button ui-button--primary" data-open-upload><i class="bi bi-plus-lg" aria-hidden="true"></i> {{ trans('photos.manage.add_photos') }}</button>{% endif %}
                </div>
                {% if newPhotoUrl %}{% include 'components/users/photo-uploader.twig' %}{% endif %}
            <div class="users-album-toolbar users-actions" data-album-toolbar{% if not photoItems %} hidden{% endif %}>
                <button type="button" class="ui-button ui-button--secondary" data-album-select aria-pressed="false">{{ trans('photos.manage.select') }}</button>
                <button type="button" class="ui-button ui-button--secondary" data-album-reorder aria-pressed="false">{{ trans('photos.manage.reorder') }}</button>
                <div class="users-actions" data-album-order-actions hidden>
                    <button type="button" class="ui-button ui-button--primary" data-album-save-order disabled>{{ trans('photos.manage.save_order') }}</button>
                    <button type="button" class="ui-button ui-button--secondary" data-album-cancel-order>{{ trans('photos.manage.cancel_order') }}</button>
                </div>
                <div class="users-actions" data-album-selection hidden>
                    <label><input type="checkbox" data-album-select-all> {{ trans('photos.manage.all') }}</label>
                    <span data-album-selection-count role="status"></span>
                    <div class="users-actions" data-album-selection-actions hidden>
                    <button type="button" class="ui-button ui-button--secondary" data-album-delete-selected>{{ trans('photos.manage.delete_selected') }}</button>
                    </div>
                </div>
            </div>
            <p class="ui-help" id="album-reorder-hint" data-album-reorder-hint hidden>{{ trans('photos.manage.reorder_hint') }}</p>
            <p data-album-status role="status" aria-live="polite"></p>
            <p data-album-empty{% if photoItems %} hidden{% endif %}>{{ trans('photos.empty_album') }}</p>
            {% include 'components/users/photo-grid.twig' %}
            <template data-photo-card-template>{% include 'components/users/photo-card.twig' with {item: {slug: '', title: '', caption: '', url: '', previewUrl: '', cover: false}} %}</template>
            </section>
        {% elseif photo %}
            <figure><a href="{{ photoOriginalUrl }}"><img class="users-photo-image" src="{{ photoPreviewUrl }}" alt="{{ photo.title }}"></a>
                {% if photo.description %}<figcaption>{{ photo.description|striptags }}</figcaption>{% endif %}
            </figure>
            <a href="{{ photoOriginalUrl }}">{{ trans('photos.original') }}</a>
        {% elseif isAlbumForm %}
            <form id="photoAlbumForm" data-photo-album-form data-api-url="{{ apiUrl }}" data-method="POST">
                <div class="ui-card users-panel">
                    <label class="ui-label users-caps" for="album-title">{{ trans('photos.album') }}</label>
                    <input class="ui-input users-input-lg" id="album-title" name="title" required maxlength="255">
                    <label class="ui-label users-caps" for="album-description">{{ trans('photos.description') }}</label>
                    <textarea class="ui-input" id="album-description" name="description" rows="5" maxlength="2000"></textarea>
                    <div class="users-form-error" data-photo-album-error role="alert"></div>
                </div>
            </form>
        {% elseif album %}
            {% if album.description %}<p>{{ album.description|striptags }}</p>{% endif %}
            {% if coverUrl %}<img class="users-album-cover" src="{{ coverUrl }}" alt="{{ album.title }}">{% endif %}
            {% if photoItems %}{% include 'components/users/photo-grid.twig' %}{% else %}<p>{{ trans('photos.empty_album') }}</p>{% endif %}
        {% else %}
            <ul class="users-feed">{% for item in albums %}<li class="ui-card users-panel"><a href="{{ item.url }}">{{ item.title }}</a></li>{% else %}<li>{{ trans('photos.empty') }}</li>{% endfor %}</ul>
        {% endif %}
        {% if not isManage and not isAlbumForm and not photo %}
            <nav aria-label="{{ trans('photos.pagination') }}">
                {% if previousUrl %}<a class="ui-button" href="{{ previousUrl }}">{{ trans('photos.previous') }}</a>{% endif %}
                {% if nextUrl %}<a class="ui-button" href="{{ nextUrl }}">{{ trans('photos.next') }}</a>{% endif %}
            </nav>
        {% endif %}
    </section>
{% endblock %}

{% block sidebar_widgets %}
    {% if isAlbumForm %}
        <div class="blog-post-sidebar-sticky">
            <div class="ui-card users-panel">
                <h2 class="users-panel__title"><i class="bi bi-person-check" aria-hidden="true"></i> {{ trans('photos.visibility') }}</h2>
                {% for value, label in {public: trans('photos.public'), members: isCommunityGallery ? trans('photos.members') : trans('view.users.blog.post.form.09'), private: trans('photos.private')} %}
                    <div class="ui-check{% if not loop.first %} users-gap{% endif %}">
                        <input class="ui-check__input" type="radio" name="visibility" id="album-visibility-{{ value }}" value="{{ value }}" form="photoAlbumForm"{% if loop.first %} checked{% endif %}>
                        <label class="ui-check__label" for="album-visibility-{{ value }}">{{ label }}</label>
                    </div>
                {% endfor %}
                <div class="users-stack">
                    <button class="ui-button ui-button--primary" type="submit" form="photoAlbumForm" data-photo-album-submit>
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ trans('photos.create') }}
                    </button>
                    <a href="{{ listUrl }}" class="ui-button ui-button--link users-cancel">
                        <i class="bi bi-x-lg" aria-hidden="true"></i> {{ trans('view.comments.cancel') }}
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
