{% extends "layouts/with-sidebar.twig" %}

{% block content %}

    {% block blog_feed_header %}
        <div class="users-heading">
            <h2>{{ trans('view.users.show.01') }}</h2>
            {% if isOwnProfile and newPostUrl %}
                <a href="{{ newPostUrl }}" class="ui-button ui-button--primary ui-button--sm">
                    <i class="bi bi-plus-lg"></i> {{ trans('blog.new_post') }}
                </a>
            {% endif %}
        </div>
    {% endblock %}

    {% block blog_feed %}
        {# data-posts-api-url is read by users.ts's initBlogFeedLoadMore() -
           a click on .load-more-blog-posts inside this container fetches
           the next batch and appends copies of the post-card template below
           to #blog-feed-posts, rather than reloading the page. #}
        <div id="blog-feed" data-posts-api-url="{{ postsApiUrl }}">
            {% if hasPosts %}
                <div class="users-feed" id="blog-feed-posts">
                    {% for post in posts %}
                        {% block blog_feed_item %}
                            {% include 'components/users/post-card.twig' with {post: post} only %}
                        {% endblock %}
                    {% endfor %}
                </div>

                {% if nextCursor is not null %}
                    <div class="users-more" data-blog-feed-load-more-wrapper>
                        <button
                            type="button"
                            class="ui-button ui-button--secondary load-more-blog-posts"
                            data-cursor="{{ nextCursor }}"
                        >
                            {{ trans('view.users.community.sidebar.13') }}
                        </button>
                    </div>

                    <template data-ui="post-card">
                        {%- include 'components/users/post-card.twig' with {post: {}, asTemplate: true} only -%}
                    </template>
                    <template data-ui="post-card-tag">
                        {%- include 'components/users/post-tag.twig' with {tag: ''} only -%}
                    </template>
                {% endif %}
            {% endif %}

            {% if isEmpty %}
                <div class="ui-card users-empty">
                    <i class="bi bi-journal-text users-empty__icon"></i>
                    {% if isOwnProfile %}
                        <p class="users-empty__title">{{ trans('view.users.show.02') }}</p>
                        <p class="users-empty__text">{{ trans('view.users.show.03') }}</p>
                        {% if newPostUrl %}
                            <a href="{{ newPostUrl }}" class="ui-button ui-button--primary users-empty__action"><i class="bi bi-plus-lg"></i> {{ trans('view.users.community.show.03') }}</a>
                        {% endif %}
                    {% else %}
                        <p class="users-empty__title">{{ trans('view.users.show.04') }}</p>
                        <p class="users-empty__text">{{ trans('view.users.first_post_hint', {name: profileUser.getDisplayName()}) }}</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endblock %}

{% endblock %}

{% block sidebar_widgets %}

    {% include 'components/users/profile-sidebar.twig' %}

    {% include 'components/users/audio-player.twig' with {audioPlaylist: audioPlaylist} only %}

    {% block profile_stats %}
        {% set statsRows = [
            {label: trans('view.users.show.07'), value: postCount},
            {label: trans('view.users.community.sidebar.11'), value: commentCount},
        ] %}
        {% if registeredAtLabel %}
            {% set statsRows = statsRows|merge([{label: trans('view.forums.topic.view.23'), value: registeredAtLabel}]) %}
        {% endif %}
        {% include 'components/common/stats-card.twig' with {rows: statsRows} only %}
    {% endblock %}

    {% block profile_friends %}
        {# data-friends-api-url is read by users.ts's initFriendsLoadMore() -
           same "Show more" pattern as #blog-feed: rows are copies of the
           person-row template. Only mutual friendships show up here - see
           FriendService's own docblock for why a one-directional subscriber
           isn't a "friend" yet. #}
        <div class="ui-card users-panel" id="friends-list" data-friends-api-url="{{ friendsApiUrl }}">
            <h2 class="users-panel__title">
                {{ trans('view.users.show.08') }}
                {% if friendsTotal %}<span class="ui-muted">({{ friendsTotal }})</span>{% endif %}
            </h2>
            {% if hasFriends %}
                <div class="users-people" id="friends-list-items">
                    {% for friend in friends %}
                        {% block friends_list_item %}
                            {% include 'components/users/person-row.twig' with {row: friend} only %}
                        {% endblock %}
                    {% endfor %}
                </div>
                {% if friendsNextOffset is not null %}
                    <div class="users-more users-more--compact" data-friends-load-more-wrapper>
                        <button type="button" class="ui-button ui-button--secondary ui-button--sm load-more-friends" data-offset="{{ friendsNextOffset }}">
                            {{ trans('view.users.community.sidebar.13') }}
                        </button>
                    </div>
                    <template data-ui="person-row">
                        {%- include 'components/users/person-row.twig' with {row: {}, asTemplate: true} only -%}
                    </template>
                {% endif %}
            {% else %}
                <p class="users-note">
                    {% if isOwnProfile %}{{ trans('view.users.show.09') }}{% else %}{{ trans('view.users.show.10') }}{% endif %}
                </p>
            {% endif %}
        </div>
    {% endblock %}

{% endblock %}
