{% extends "layouts/with-sidebar.twig" %}

{% block content %}

    {% block community_feed_header %}
        <div class="users-heading">
            <h1 class="users-heading__title">{{ trans('community.page_title') }}</h1>
            {% if isGuest or newPostUrl %}
                <a href="{{ isGuest ? '#authFormModal' : newPostUrl }}" {% if isGuest %}data-ui-toggle="modal" data-ui-target="#authFormModal"{% endif %} class="ui-button ui-button--primary ui-button--sm">
                    <i class="bi bi-plus-lg"></i> {{ trans('view.users.community.01') }}
                </a>
            {% endif %}
        </div>
    {% endblock %}

    {% if activeTag %}
        <div class="ui-alert users-tag-filter" role="alert">
            <span>{{ trans('view.users.community.02') }} <strong>#{{ activeTag }}</strong></span>
            <a href="{{ communityUrl }}" class="ui-button ui-button--secondary ui-button--sm">{{ trans('view.users.community.03') }}</a>
        </div>
    {% endif %}

    {% block community_feed %}
        {# data-posts-api-url is read by users.ts's
           initCommunityFeedLoadMore() - same "Show more" AJAX-append
           pattern as the profile page's #blog-feed /
           initBlogFeedLoadMore(): a click on .load-more-community-posts
           inside this container fetches the next batch from it and appends
           cards to #community-feed-posts, rather than reloading the page. #}
        <div id="community-feed" data-posts-api-url="{{ postsApiUrl }}">
            {% if hasPosts %}
                <div class="users-feed" id="community-feed-posts">
                    {% for post in posts %}
                        {% block community_feed_item %}
                            {% include 'components/users/post-card.twig' with {post: post, showAuthor: true} only %}
                        {% endblock %}
                    {% endfor %}
                </div>

                {% if nextOffset is not null %}
                    <div class="users-more" data-community-feed-load-more-wrapper>
                        <button
                            type="button"
                            class="ui-button ui-button--secondary load-more-community-posts"
                            data-offset="{{ nextOffset }}"
                        >
                            {{ trans('view.users.community.sidebar.13') }}
                        </button>
                    </div>
                    <template data-ui="post-card">
                        {%- include 'components/users/post-card.twig' with {post: {}, showAuthor: true, asTemplate: true} only -%}
                    </template>
                    <template data-ui="post-card-tag">
                        {%- include 'components/users/post-tag.twig' with {tag: ''} only -%}
                    </template>
                {% endif %}
            {% endif %}

            {% if isEmpty %}
                <div class="ui-card users-empty">
                    <i class="bi bi-journal-text users-empty__icon"></i>
                    {% if activeTag %}
                        <p class="users-empty__title">{{ trans('view.users.community.04') }}</p>
                    {% else %}
                        <p class="users-empty__title">{{ trans('view.users.community.show.02') }}</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endblock %}

{% endblock %}

{% block sidebar_widgets %}

    {% block community_actions %}
        {# "Write" already lives in the content header
           (community_feed_header block) - not repeated here. #}
        <div class="users-sidebar-actions">
            {% if isGuest %}
                <button type="button" class="ui-button ui-button--secondary" data-ui-toggle="modal" data-ui-target="#authFormModal">
                    <i class="bi bi-people"></i> {{ trans('view.users.community.create.04') }}
                </button>
            {% elseif createCommunityUrl %}
                <a href="{{ createCommunityUrl }}" class="ui-button ui-button--secondary">
                    <i class="bi bi-people"></i> {{ trans('view.users.community.create.04') }}
                </a>
            {% else %}
                {# Falls back to a disabled stub if community.create
                   isn't registered in `pages` (e.g. its migration hasn't
                   run yet) rather than linking to a 404. #}
                <button type="button" class="ui-button ui-button--secondary" disabled>
                    <i class="bi bi-people"></i> {{ trans('view.users.community.create.04') }}
                </button>
            {% endif %}
        </div>
    {% endblock %}

    {% block community_mine %}
        {% if not isGuest %}
            <div class="ui-card users-panel">
                <div>
                    <h2 class="users-panel__title">{{ trans('view.users.community.05') }}</h2>
                    {% if myCommunities %}
                        <div class="users-people">
                            {% for community in myCommunities %}
                                {% block community_mine_item %}
                                    <a href="{{ community.url ?: '#' }}" class="users-person">
                                        <img src="{{ community.imageUrl }}" alt="" class="users-person__avatar" width="36" height="36">
                                        <span class="users-person__name"><bdi>{{ community.title }}</bdi></span>
                                        <span class="ui-badge users-person__end users-role users-role--{{ community.statusTone }}">{{ community.statusLabel }}</span>
                                    </a>
                                {% endblock %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="users-note">{{ trans('view.users.community.06') }}</p>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% endblock %}

    {% block community_popular %}
        {# popularCommunities: UsersController::buildPopularCommunitiesWidget()
           - ranked by real member count (FeedService::getMostMembersByType()),
           each card's memberCount always set (possibly 0). #}
        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title">{{ trans('view.users.community.07') }}</h2>
                {% if popularCommunities %}
                    <div class="users-people">
                        {% for community in popularCommunities %}
                            {% block community_popular_item %}
                                <a href="{{ community.url ?: '#' }}" class="users-person">
                                    <img src="{{ community.imageUrl }}" alt="" class="users-person__avatar" width="36" height="36">
                                    <span class="users-person__name"><bdi>{{ community.title }}</bdi></span>
                                    {% if community.memberCount is not null %}
                                        <span class="ui-badge users-person__end">{{ community.memberCount }}</span>
                                    {% endif %}
                                </a>
                            {% endblock %}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="users-note">{{ trans('view.users.community.08') }}</p>
                {% endif %}
            </div>
        </div>
    {% endblock %}

    {% block community_new %}
        {# newCommunities: UsersController::buildNewCommunitiesWidget() -
           the most recently created communities (FeedService::getFeedsByType(),
           already ordered by created_at DESC). #}
        <div class="ui-card users-panel">
            <div>
                <h2 class="users-panel__title">{{ trans('view.users.community.09') }}</h2>
                {% if newCommunities %}
                    <div class="users-people">
                        {% for community in newCommunities %}
                            {% block community_new_item %}
                                <a href="{{ community.url ?: '#' }}" class="users-person">
                                    <img src="{{ community.imageUrl }}" alt="" class="users-person__avatar" width="36" height="36">
                                    <span class="users-person__name"><bdi>{{ community.title }}</bdi></span>
                                    {% if community.createdAtLabel %}
                                        <span class="ui-muted ui-small users-person__end">{{ community.createdAtLabel }}</span>
                                    {% endif %}
                                </a>
                            {% endblock %}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="users-note">{{ trans('view.users.community.10') }}</p>
                {% endif %}
            </div>
        </div>
    {% endblock %}

    {% block community_tag_cloud %}
        {# tagCloud: UsersController::buildCommunityTagCloud() - each tag's
           own fontSize (rem) is already scaled server-side by how often it's
           used (see that method's own docblock), no count number shown. #}
        {% if tagCloud %}
            <div class="ui-card users-panel">
                <div>
                    <h2 class="users-panel__title">{{ trans('view.users.community.11') }}</h2>
                    <div class="users-tag-cloud">
                        {% for tag in tagCloud %}
                            <a
                                href="{{ tag.url }}"
                                class="users-tag-cloud__tag{% if activeTag == tag.slug %} is-active{% endif %}"
                                style="font-size: {{ tag.fontSize }}rem;"
                            >#{{ tag.name }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    {% endblock %}

{% endblock %}
