{% extends "layouts/single.twig" %}

{# action=community.manage: the community owner's own settings +
   member-moderation page - no sidebar (see layouts/single.twig), two tabs
   (components/ui/tabs.twig), same shape as modules/profile/page.twig.
   See UsersController::showCommunityManagePage(). #}

{% block main_class %}layout-main users-page{% endblock %}

{% block content %}

    <div class="users-heading">
        <div class="users-person">
            <img
                src="{{ communityImageUrl }}"
                alt=""
                class="users-person__avatar"
                width="40"
                height="40"
            >
            <h1 class="users-heading__title users-heading__title--sm">{{ trans('view.users.community.manage.01') }}{{ community.title }}»</h1>
        </div>
        {% if cancelUrl %}
            <a href="{{ cancelUrl }}" class="ui-button ui-button--secondary ui-button--sm">
                <i class="bi bi-arrow-left"></i> {{ trans('view.users.community.manage.02') }}
            </a>
        {% endif %}
    </div>

    {% include 'components/ui/tabs.twig' with { tabs: tabs } %}

    <div class="{% block community_manage_tabs_class %}users-tabs{% endblock %}">
        {% for tab in tabs %}
            {% include tab.template with {
                tab: tab,
                active: loop.first
            } %}
        {% endfor %}
    </div>

{% endblock %}
