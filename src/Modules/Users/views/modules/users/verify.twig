{% extends "layouts/with-sidebar.twig" %}

{% block content %}

    {% block register_header %}
    <h1>{{ trans('user.registration') }} <small class="ui-muted">{{ trans('view.users.register2.01') }}</small></h1>
    <hr>
    {% endblock %}

    {% block verify_error %}
    <div class="ui-alert ui-alert--error">
        <p class="users-lead">{{ trans('view.users.verify.01') }}</p>
        <p class="users-tight">{{ trans('view.users.verify.02') }}</p>
    </div>
    {% endblock %}

    {% block verify_details %}
    <p>{{ trans('view.users.verify.03') }}</p>
    {% endblock %}

    {% block verify_actions %}
    {% set registerUrl = action_url('user.register') %}
    {% set feedbackUrl = action_url('feedback.show') %}
    {% if registerUrl and registrationOpen|default(true) %}
    <p>{{ trans('view.users.verify.04') }} <a href="{{ registerUrl }}">{{ trans('view.users.verify.05') }}</a> {{ trans('view.users.verify.06') }}</p>
    {% endif %}
    {% if feedbackUrl %}
    <p>{{ trans('view.users.verify.07') }} <a href="{{ feedbackUrl }}">{{ trans('view.users.verify.08') }}</a>.</p>
    {% endif %}
    {% endblock %}

{% endblock %}
