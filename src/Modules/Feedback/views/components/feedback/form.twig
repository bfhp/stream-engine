<form id="feedbackForm" method="post" action="/api/v1/feedback" data-success-url="{{ successUrl }}">
    <input type="hidden" name="form_time" value="{{ time }}">
    <input type="hidden" name="form_hash" value="{{ hash }}">

    <div class="ui-field">
        <label for="feedbackInputName" class="ui-label">{{ trans('view.feedback.form.01') }}</label>
        <input type="text" class="ui-input" name="full_name" autocomplete="name" required maxlength="100" id="feedbackInputName">
    </div>

    <div class="ui-field">
        <label for="feedbackInputEmail" class="ui-label">{{ trans('view.common.email') }}</label>
        <input type="email" class="ui-input" name="email" autocomplete="email" required maxlength="200" id="feedbackInputEmail">
    </div>

    {# Honeypot: hidden from people, filled by bots. #}
    <div class="ui-visually-hidden" aria-hidden="true">
        <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off">
        </label>
    </div>

    <div class="ui-field">
        <label for="feedbackInputMessage" class="ui-label">{{ trans('view.ui.message') }}</label>
        <textarea minlength="30" class="ui-input" name="message" rows="6" required maxlength="2000" id="feedbackInputMessage" aria-describedby="feedbackMessageHelp"></textarea>
        <div class="ui-help" id="feedbackMessageHelp">{{ trans('view.feedback.form.help_message') }}</div>
    </div>

    <button type="submit" class="ui-button ui-button--primary">
        {{ trans('view.feedback.form.02') }}
    </button>
</form>
