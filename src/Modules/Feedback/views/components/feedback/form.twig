<form id="feedbackForm" method="post" action="/api/v1/feedback" data-success-url="{{ successUrl }}">
    <input type="hidden" name="form_time" value="{{ time }}">
    <input type="hidden" name="form_hash" value="{{ hash }}">

    <div class="ui-field">
        <label for="feedbackInputName" class="ui-label">{{ trans('view.feedback.form.01') }}</label>
        <input type="text" class="ui-input" name="full_name" required maxlength="100" id="feedbackInputName">
    </div>

    <div class="ui-field">
        <label for="feedbackInputEmail" class="ui-label">Email</label>
        <input type="email" class="ui-input" name="email" required maxlength="200" id="feedbackInputEmail">
    </div>

    {# Honeypot: hidden from people, filled by bots. #}
    <div class="ui-visually-hidden">
        <label>
            Website
            <input type="text" name="website">
        </label>
    </div>

    <div class="ui-field">
        <label for="feedbackInputMessage" class="ui-label">{{ trans('view.ui.message') }}</label>
        <textarea minlength="30" class="ui-input" name="message" rows="6" required maxlength="2000" id="feedbackInputMessage"></textarea>
    </div>

    <button type="submit" class="ui-button ui-button--primary">
        {{ trans('view.feedback.form.02') }}
    </button>
</form>
