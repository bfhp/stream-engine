{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" action="/api/v1/my/forum" data-profile-form>
        <div class="ui-field">
            <label class="ui-label">{{ trans('view.profile.tabs.forum.01') }}</label>
            <textarea class="ui-input" name="signature" rows="5">{{ user.signature }}</textarea>
            <div class="ui-help">
                {{ trans('view.profile.tabs.forum.02') }}
                <code>&lt;b&gt;</code>, <code>&lt;i&gt;</code>, <code>&lt;a&gt;</code> {{ trans('view.forums.topic.form.36') }}
                <code>&lt;img&gt;</code> {{ trans('view.profile.tabs.forum.03') }}
            </div>
        </div>
        <div class="profile-actions">
            <button class="ui-button ui-button--primary" type="submit">{{ trans('view.forums.topic.form.41') }}</button>
            <span class="profile-status" data-profile-status></span>
        </div>
    </form>
{% endblock %}
