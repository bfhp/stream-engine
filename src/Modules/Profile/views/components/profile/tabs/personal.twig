{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" action="/api/v1/my" data-profile-personal-form>
        <input type="hidden" name="avatar_url" value="{{ user.avatarUrl }}" data-profile-avatar-url>

        <div class="profile-section">
            <label class="ui-label" for="profileAvatarFile">{{ trans('view.profile.tabs.personal.01') }}</label>
            <div class="profile-avatar-row">
                <img
                    src="{{ user.avatarUrl }}"
                    alt="{{ user.getDisplayName() }}"
                    class="profile-avatar-preview"
                    width="96"
                    height="96"
                    data-profile-avatar-preview
                >
                <div class="profile-avatar-row__input">
                    <input type="file" class="ui-input" accept="image/*" id="profileAvatarFile" aria-describedby="profileAvatarHelp" data-profile-avatar-file>
                    <div class="ui-help" id="profileAvatarHelp">{{ trans('view.profile.tabs.personal.02') }}</div>
                </div>
            </div>
        </div>

        <div class="ui-field">
            <label class="ui-label" for="profileNick">{{ trans('view.feedback.form.01') }}</label>
            <input id="profileNick" type="text" name="nick" class="ui-input" value="{{ user.nick }}" aria-describedby="profileNickHelp">
            <div class="ui-help" id="profileNickHelp">{{ trans('view.profile.tabs.personal.03') }}</div>
        </div>
        <div class="ui-field">
            <label class="ui-label" for="profileHomepage">{{ trans('view.profile.tabs.personal.04') }}</label>
            <input id="profileHomepage" type="url" name="homepage" class="ui-input" value="{{ user.homepage }}" placeholder="https://example.com">
        </div>
        <div class="ui-field">
            <label class="ui-label" for="profileGender">{{ trans('view.profile.tabs.personal.05') }}</label>
            <select id="profileGender" name="gender" class="ui-select">
                <option value="" {% if user.gender == '' %}selected{% endif %}>{{ trans('view.profile.tabs.personal.06') }}</option>
                <option value="male" {% if user.gender == 'male' %}selected{% endif %}>{{ trans('view.profile.tabs.personal.07') }}</option>
                <option value="female" {% if user.gender == 'female' %}selected{% endif %}>{{ trans('view.profile.tabs.personal.08') }}</option>
                <option value="other" {% if user.gender == 'other' %}selected{% endif %}>{{ trans('view.profile.tabs.personal.09') }}</option>
            </select>
        </div>
        <div class="ui-field">
            <label class="ui-label" for="profileBirthDate">{{ trans('view.profile.tabs.personal.10') }}</label>
            <input id="profileBirthDate" type="date" name="birth_date" class="ui-input" value="{{ user.birthDate }}">
        </div>
        <div class="ui-field">
            <label class="ui-label" for="profileBio">{{ trans('view.profile.tabs.personal.11') }}</label>
            <textarea id="profileBio" name="bio" class="ui-input" rows="4">{{ user.bio }}</textarea>
        </div>
        <div class="profile-actions">
            <button class="ui-button ui-button--primary" type="submit">{{ trans('view.forums.topic.form.41') }}</button>
            <span class="profile-status" data-profile-personal-status></span>
        </div>
    </form>
{% endblock %}
