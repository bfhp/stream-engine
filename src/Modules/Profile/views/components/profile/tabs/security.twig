{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" action="/profile/security">
        <div class="ui-field">
            <label class="ui-label" for="profileEmail">{{ trans('view.profile.tabs.security.01') }}</label>
            <input id="profileEmail" type="email" name="email" autocomplete="email" class="ui-input" value="{{ user.email }}">
        </div>
        <div class="ui-field">
            <label class="ui-label" for="profilePassword">{{ trans('view.profile.tabs.security.02') }}</label>
            <input id="profilePassword" type="password" name="password" autocomplete="new-password" minlength="10" maxlength="255" class="ui-input" aria-describedby="profilePasswordHelp">
            <div id="profilePasswordHelp" class="ui-help">{{ trans('view.profile.tabs.security.04') }}</div>
        </div>
        <button class="ui-button ui-button--danger">{{ trans('view.profile.tabs.security.03') }}</button>
    </form>
{% endblock %}
