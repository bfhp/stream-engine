{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" enctype="multipart/form-data" action="/profile/avatar">
        <div class="mb-3">
            <img src="{{ user.avatar_url }}" class="img-thumbnail mb-3" width="150">
            <input type="file" name="avatar" class="form-control">
        </div>
        <button class="btn btn-primary">{{ trans('view.profile.tabs.avatars.01') }}</button>
    </form>
{% endblock %}
