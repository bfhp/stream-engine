{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" enctype="multipart/form-data" action="/profile/avatar">
        <div class="ui-field">
            <img src="{{ user.avatar_url }}" class="profile-avatar-thumb" width="150" alt="">
            <input type="file" name="avatar" class="ui-input">
        </div>
        <button class="ui-button ui-button--primary">{{ trans('view.profile.tabs.avatars.01') }}</button>
    </form>
{% endblock %}
