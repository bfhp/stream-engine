{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" action="/api/v1/my/privacy" data-profile-form>
        <div class="profile-section">
            <h2 class="profile-section-title">{{ trans('view.profile.tabs.privacy.01') }}</h2>
            <p class="ui-muted ui-small">{{ trans('view.profile.tabs.privacy.02') }}</p>

            <div class="ui-check">
                <input class="ui-check__input" type="checkbox" id="privacy-show-gender" name="show_gender_publicly" value="1" {% if user.showGenderPublicly %}checked{% endif %}>
                <label class="ui-check__label" for="privacy-show-gender">{{ trans('view.profile.tabs.privacy.03') }}</label>
            </div>
            <div class="ui-check">
                <input class="ui-check__input" type="checkbox" id="privacy-show-birth-date" name="show_birth_date_publicly" value="1" {% if user.showBirthDatePublicly %}checked{% endif %}>
                <label class="ui-check__label" for="privacy-show-birth-date">{{ trans('view.profile.tabs.privacy.04') }}</label>
            </div>
            <div class="ui-check">
                <input class="ui-check__input" type="checkbox" id="privacy-show-homepage" name="show_homepage_publicly" value="1" {% if user.showHomepagePublicly %}checked{% endif %}>
                <label class="ui-check__label" for="privacy-show-homepage">{{ trans('view.profile.tabs.privacy.05') }}</label>
            </div>
        </div>

        <div class="profile-section">
            <h2 class="profile-section-title">{{ trans('view.profile.tabs.privacy.06') }}</h2>
            <div class="ui-check">
                <input class="ui-check__input" type="checkbox" id="privacy-hide-presence" name="hide_presence" value="1" {% if user.hidePresence %}checked{% endif %}>
                <label class="ui-check__label" for="privacy-hide-presence">{{ trans('view.profile.tabs.privacy.07') }}</label>
            </div>
        </div>

        <div class="ui-check profile-section">
            <input class="ui-check__input" type="checkbox" id="privacy-show-hidden-to-friends" name="show_hidden_profile_to_friends" value="1" {% if user.showHiddenProfileToFriends %}checked{% endif %}>
            <label class="ui-check__label" for="privacy-show-hidden-to-friends">{{ trans('view.profile.tabs.privacy.08') }}</label>
            <div class="ui-help">{{ trans('view.profile.tabs.privacy.09') }}</div>
        </div>

        <div class="profile-actions">
            <button class="ui-button ui-button--primary" type="submit">{{ trans('view.forums.topic.form.41') }}</button>
            <span class="profile-status" data-profile-status></span>
        </div>
    </form>
{% endblock %}
