{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" action="/api/v1/my/privacy" data-profile-form>
        <div class="mb-4">
            <h2 class="h5 mb-2">{{ trans('view.profile.tabs.privacy.01') }}</h2>
            <p class="text-body-secondary small mb-3">{{ trans('view.profile.tabs.privacy.02') }}</p>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="privacy-show-gender" name="show_gender_publicly" value="1" {% if user.showGenderPublicly %}checked{% endif %}>
                <label class="form-check-label" for="privacy-show-gender">{{ trans('view.profile.tabs.privacy.03') }}</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="privacy-show-birth-date" name="show_birth_date_publicly" value="1" {% if user.showBirthDatePublicly %}checked{% endif %}>
                <label class="form-check-label" for="privacy-show-birth-date">{{ trans('view.profile.tabs.privacy.04') }}</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="privacy-show-homepage" name="show_homepage_publicly" value="1" {% if user.showHomepagePublicly %}checked{% endif %}>
                <label class="form-check-label" for="privacy-show-homepage">{{ trans('view.profile.tabs.privacy.05') }}</label>
            </div>
        </div>

        <div class="mb-4">
            <h2 class="h5 mb-2">{{ trans('view.profile.tabs.privacy.06') }}</h2>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="privacy-hide-presence" name="hide_presence" value="1" {% if user.hidePresence %}checked{% endif %}>
                <label class="form-check-label" for="privacy-hide-presence">{{ trans('view.profile.tabs.privacy.07') }}</label>
            </div>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="privacy-show-hidden-to-friends" name="show_hidden_profile_to_friends" value="1" {% if user.showHiddenProfileToFriends %}checked{% endif %}>
            <label class="form-check-label" for="privacy-show-hidden-to-friends">{{ trans('view.profile.tabs.privacy.08') }}</label>
            <div class="form-text">{{ trans('view.profile.tabs.privacy.09') }}</div>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button class="btn btn-primary" type="submit">{{ trans('view.forums.topic.form.41') }}</button>
            <span class="text-body-secondary small" data-profile-status></span>
        </div>
    </form>
{% endblock %}
