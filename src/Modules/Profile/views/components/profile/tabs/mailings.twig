{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" action="/api/v1/my/mailings" data-profile-form>
        <p class="ui-muted">
            {{ trans('view.profile.tabs.mailings.01') }}
        </p>

        <div class="ui-card profile-digest">
            <div class="ui-card__body profile-digest__body">
                <div>
                    <h2 class="profile-section-title">{{ trans('view.profile.tabs.mailings.02') }}</h2>
                    <p class="ui-muted ui-small profile-note">
                        {{ trans('view.profile.tabs.mailings.03') }}
                    </p>
                </div>
                <div class="profile-digest__time">
                    <label class="ui-label" for="notification-digest-time">{{ trans('view.profile.tabs.mailings.04') }}</label>
                    <input
                        class="ui-input"
                        type="time"
                        id="notification-digest-time"
                        name="digest_delivery_time"
                        value="{{ notificationDigestTime }}"
                        required
                    >
                </div>
            </div>
        </div>

        <div class="ui-card profile-mailings">
            <div class="ui-table-scroll">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ trans('view.profile.tabs.mailings.05') }}</th>
                            <th scope="col" class="profile-mailings__center">{{ trans('view.profile.tabs.mailings.06') }}</th>
                            <th scope="col" class="profile-mailings__center">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for preference in notificationPreferences %}
                            <tr title="{{ preference.description }}">
                                <th scope="row" class="profile-mailings__label">{{ preference.label }}</th>
                                <td class="profile-mailings__cell">
                                    {% if preference.digestOnly|default(false) %}
                                        <span class="ui-muted">—</span>
                                    {% else %}
                                    <fieldset>
                                        <legend class="ui-visually-hidden">{{ trans('view.profile.tabs.mailings.07') }} {{ preference.label }}</legend>
                                        <div class="ui-segmented" role="group" aria-label="{{ trans('view.profile.messenger_aria', {label: preference.label}) }}">
                                            <input class="ui-segmented__input" type="radio" id="{{ preference.key }}-messenger-instant" name="{{ preference.key }}_messenger" value="instant" {% if preference.messenger == 'instant' %}checked{% endif %}>
                                            <label class="ui-segmented__option" for="{{ preference.key }}-messenger-instant">{{ trans('view.profile.tabs.mailings.08') }}</label>

                                            <input class="ui-segmented__input" type="radio" id="{{ preference.key }}-messenger-off" name="{{ preference.key }}_messenger" value="off" {% if preference.messenger == 'off' %}checked{% endif %}>
                                            <label class="ui-segmented__option" for="{{ preference.key }}-messenger-off">{{ trans('view.profile.tabs.mailings.09') }}</label>
                                        </div>
                                    </fieldset>
                                    {% endif %}
                                </td>
                                <td class="profile-mailings__cell">
                                    <fieldset>
                                        <legend class="ui-visually-hidden">Email: {{ preference.label }}</legend>
                                        <div class="ui-segmented" role="group" aria-label="Email: {{ preference.label }}">
                                            <input class="ui-segmented__input" type="radio" id="{{ preference.key }}-email-off" name="{{ preference.key }}_email" value="off" {% if preference.email == 'off' %}checked{% endif %}>
                                            <label class="ui-segmented__option" for="{{ preference.key }}-email-off">{{ trans('view.profile.tabs.mailings.09') }}</label>

                                            {% if not preference.digestOnly|default(false) %}
                                            <input class="ui-segmented__input" type="radio" id="{{ preference.key }}-email-instant" name="{{ preference.key }}_email" value="instant" {% if preference.email == 'instant' %}checked{% endif %}>
                                            <label class="ui-segmented__option" for="{{ preference.key }}-email-instant">{{ trans('view.profile.tabs.mailings.08') }}</label>
                                            {% endif %}

                                            <input class="ui-segmented__input" type="radio" id="{{ preference.key }}-email-daily" name="{{ preference.key }}_email" value="daily" {% if preference.email == 'daily' %}checked{% endif %}>
                                            <label class="ui-segmented__option" for="{{ preference.key }}-email-daily">{{ trans('view.profile.tabs.mailings.10') }}</label>
                                        </div>
                                    </fieldset>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="profile-actions">
            <button class="ui-button ui-button--primary" type="submit">{{ trans('view.forums.topic.form.41') }}</button>
            <span class="profile-status" data-profile-status></span>
        </div>
    </form>
{% endblock %}
