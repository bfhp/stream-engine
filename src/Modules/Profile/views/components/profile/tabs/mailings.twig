{% extends 'components/ui/tab-pane.twig' %}

{% block tab_content %}
    <form method="post" action="/api/v1/my/mailings" data-profile-form>
        <p class="text-body-secondary">
            {{ trans('view.profile.tabs.mailings.01') }}
        </p>

        <div class="card border-primary-subtle mb-4">
            <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h2 class="h5 mb-1">{{ trans('view.profile.tabs.mailings.02') }}</h2>
                    <p class="text-body-secondary small mb-0">
                        {{ trans('view.profile.tabs.mailings.03') }}
                    </p>
                </div>
                <div class="flex-shrink-0">
                    <label class="form-label" for="notification-digest-time">{{ trans('view.profile.tabs.mailings.04') }}</label>
                    <input
                        class="form-control"
                        type="time"
                        id="notification-digest-time"
                        name="digest_delivery_time"
                        value="{{ notificationDigestTime }}"
                        required
                    >
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">{{ trans('view.profile.tabs.mailings.05') }}</th>
                            <th scope="col" class="text-center">{{ trans('view.profile.tabs.mailings.06') }}</th>
                            <th scope="col" class="text-center">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for preference in notificationPreferences %}
                            <tr title="{{ preference.description }}">
                                <th scope="row" class="fw-medium text-nowrap">{{ preference.label }}</th>
                                <td class="text-nowrap">
                                    {% if preference.digestOnly|default(false) %}
                                        <span class="text-body-secondary">—</span>
                                    {% else %}
                                    <fieldset>
                                        <legend class="visually-hidden">{{ trans('view.profile.tabs.mailings.07') }} {{ preference.label }}</legend>
                                        <div class="btn-group btn-group-sm" role="group" aria-label="{{ trans('view.profile.messenger_aria', {label: preference.label}) }}">
                                            <input class="btn-check" type="radio" id="{{ preference.key }}-messenger-instant" name="{{ preference.key }}_messenger" value="instant" {% if preference.messenger == 'instant' %}checked{% endif %}>
                                            <label class="btn btn-outline-primary" for="{{ preference.key }}-messenger-instant">{{ trans('view.profile.tabs.mailings.08') }}</label>

                                            <input class="btn-check" type="radio" id="{{ preference.key }}-messenger-off" name="{{ preference.key }}_messenger" value="off" {% if preference.messenger == 'off' %}checked{% endif %}>
                                            <label class="btn btn-outline-primary" for="{{ preference.key }}-messenger-off">{{ trans('view.profile.tabs.mailings.09') }}</label>
                                        </div>
                                    </fieldset>
                                    {% endif %}
                                </td>
                                <td class="text-nowrap">
                                    <fieldset>
                                        <legend class="visually-hidden">Email: {{ preference.label }}</legend>
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Email: {{ preference.label }}">
                                            <input class="btn-check" type="radio" id="{{ preference.key }}-email-off" name="{{ preference.key }}_email" value="off" {% if preference.email == 'off' %}checked{% endif %}>
                                            <label class="btn btn-outline-primary" for="{{ preference.key }}-email-off">{{ trans('view.profile.tabs.mailings.09') }}</label>

                                            {% if not preference.digestOnly|default(false) %}
                                            <input class="btn-check" type="radio" id="{{ preference.key }}-email-instant" name="{{ preference.key }}_email" value="instant" {% if preference.email == 'instant' %}checked{% endif %}>
                                            <label class="btn btn-outline-primary" for="{{ preference.key }}-email-instant">{{ trans('view.profile.tabs.mailings.08') }}</label>
                                            {% endif %}

                                            <input class="btn-check" type="radio" id="{{ preference.key }}-email-daily" name="{{ preference.key }}_email" value="daily" {% if preference.email == 'daily' %}checked{% endif %}>
                                            <label class="btn btn-outline-primary" for="{{ preference.key }}-email-daily">{{ trans('view.profile.tabs.mailings.10') }}</label>
                                        </div>
                                    </fieldset>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button class="btn btn-primary" type="submit">{{ trans('view.forums.topic.form.41') }}</button>
            <span class="text-body-secondary small" data-profile-status></span>
        </div>
    </form>
{% endblock %}
